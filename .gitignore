target/
*.cwasm
.ostro/
node_modules/
__pycache__/
.venv/
spikes/**/out/
spikes/**/target/
spikes/**/*.wasm
ci/deny-fixtures/**/target/
# guests/: each plan adds guest crates under `members = ["*"]`, so a committed lock
# would be a cross-plan conflict point; versions are pinned exactly in guests/Cargo.toml.
guests/Cargo.lock
# sdks/rust/: separate SDK workspace; versions pinned exactly in its manifests (target/ above).
sdks/rust/Cargo.lock
# 06-18: local OSTRO_TEST_* credentials for scripts/ci-local.sh (KEY=value lines); never commit
.ostro-test-env
