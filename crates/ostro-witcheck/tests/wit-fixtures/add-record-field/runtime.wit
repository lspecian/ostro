// Ostro runtime contract, WIT 0.1.
//
// WIT 0.1 is frozen at the end of Phase 5 (WIT-07). Records, variants and enums
// can never gain fields/cases after that; additive = new functions/interfaces/types only.

package ostro:runtime@0.1.1;

/// Shared value types used by every other interface.
interface types {
    /// An opaque, content-typed blob (workflow inputs/outputs, step results, signals).
    record payload {
        content-type: string,
        data: list<u8>,
    }

    /// Handle to a durable operation started through `effects`. Completed via `effects.wait`.
    type op-id = u64;

    /// Wall-clock time as seconds + nanoseconds since the Unix epoch.
    record datetime {
        seconds: u64,
        nanoseconds: u32,
    }

    /// Structured error description. `kind` is matched against `retry-policy.non-retryable-kinds`.
    record error-info {
        kind: string,
        message: string,
        details: option<payload>,
    }

    /// Why an operation, step or run failed.
    variant failure {
        /// Eligible for retry under the applicable retry policy.
        retryable(error-info),
        /// Never retried; fails the step/run immediately.
        non-retryable(error-info),
        /// A timeout elapsed (step, effect or run timeout).
        timeout,
        /// The operation or run was cancelled.
        cancelled,
    }

    /// Exponential backoff retry policy.
    record retry-policy {
        max-attempts: u32,
        initial-interval-ms: u64,
        max-interval-ms: u64,
        backoff-coefficient: f64,
        non-retryable-kinds: list<string>,
    }

    /// Options for `journal.begin-step`.
    record step-options {
        retry: option<retry-policy>,
        timeout-ms: option<u64>,
        /// Fuel budget for the step body (deterministic CPU accounting).
        fuel: option<u64>,
    }

    /// Identity and metadata of the current run, stable across replays.
    record run-info {
        run-id: string,
        workflow: string,
        workflow-version: u32,
        attempt: u32,
        module-hash: string,
        tenant: option<string>,
        parent-run-id: option<string>,
        /// Run deadline derived from the run timeout, if any.
        deadline: option<datetime>,
        /// Run id this run was continued from via continue-as-new, if any.
        continued-from: option<string>,
        queue: option<string>,
    }
}

/// Deterministic run context. Every value returned here is journaled or derived
/// from journaled data, so it is identical on every replay.
interface context {
    use types.{run-info, datetime};

    /// Metadata of the current run.
    info: func() -> run-info;
    /// Deterministic workflow time (the journaled time of the current activation point).
    now: func() -> datetime;
    /// Deterministic random u64 from the run's journaled RNG seed.
    random-u64: func() -> u64;
    /// Deterministic random bytes from the run's journaled RNG seed.
    random-bytes: func(len: u32) -> list<u8>;
    /// Deterministic UUIDv7 (time from `now`, randomness from the run seed).
    uuid-v7: func() -> string;
    /// True while the guest is re-executing journaled history.
    is-replaying: func() -> bool;
    /// Versioning gate: true if `change-id` is active for this run (journals a patch marker
    /// on first evaluation in new code paths).
    patched: func(change-id: string) -> bool;
    /// Publish a JSON status document visible to clients (journaled).
    set-status: func(json: string);
    /// True when the journal has grown large enough that the guest should continue-as-new.
    continue-as-new-suggested: func() -> bool;
}

/// Durable steps. A step body runs at most once to a recorded completion; on replay the
/// recorded outcome is returned instead of re-executing.
interface journal {
    use types.{payload, step-options, failure};

    /// Host acknowledgement of a step completion.
    variant completion-ack {
        /// The outcome was journaled.
        recorded,
        /// The step failed retryably and the host wants the body re-run now (in-activation retry).
        retry-now,
    }

    /// A step being executed for the first time.
    ///
    /// Dropping a step without calling `complete` is an observability signal only;
    /// the host never relies on drop (guest toolchains may not drop completed steps).
    resource step {
        /// Journal sequence number assigned to this step.
        seq: func() -> u64;
        /// Record the step outcome.
        complete: func(outcome: result<payload, failure>) -> completion-ack;
    }

    /// Result of `begin-step`.
    variant step-start {
        /// The step already completed in history; this is its recorded outcome.
        replayed(result<payload, failure>),
        /// The step must be executed; complete it through the handle.
        execute(step),
    }

    /// Begin (or replay) the named step.
    begin-step: func(name: string, opts: step-options) -> step-start;
}

/// Durable side effects and waits. Every call allocates an `op-id` deterministically;
/// results arrive through `wait`.
interface effects {
    use types.{payload, op-id, datetime, failure, retry-policy};

    /// An HTTP header. `value` may contain `{{secret:name}}` placeholders, which are
    /// resolved by the host only and never visible to the guest or the journal.
    record header {
        name: string,
        value: string,
    }

    /// An outbound HTTP request executed by the host.
    record http-request {
        method: string,
        url: string,
        headers: list<header>,
        body: option<list<u8>>,
        timeout-ms: option<u64>,
        idempotency-key: option<string>,
        retry: option<retry-policy>,
        /// Header names whose values are redacted from the journal and logs.
        redact: list<string>,
    }

    /// HTTP response returned to the guest.
    record http-response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
    }

    /// A SQL parameter or column value.
    variant sql-value {
        null,
        boolean(bool),
        int8(s64),
        float8(f64),
        numeric(string),
        text(string),
        bytea(list<u8>),
        json(string),
        timestamptz(datetime),
    }

    /// A SQL statement executed by the host against a named connection.
    record sql-request {
        connection: string,
        statement: string,
        params: list<sql-value>,
        /// Execute with exactly-once semantics (host-side dedupe table).
        exactly-once: bool,
    }

    /// SQL statement result.
    record sql-result {
        columns: list<string>,
        rows: list<list<sql-value>>,
        rows-affected: u64,
    }

    /// An object-store operation against a named connection.
    record object-request {
        connection: string,
        op: string,
        key: string,
        body: option<list<u8>>,
    }

    /// Options for `start-child`.
    record child-options {
        queue: option<string>,
        version: option<u32>,
        /// Detached children outlive the parent and do not report completion.
        detached: bool,
        run-timeout-ms: option<u64>,
    }

    /// An await token: external systems complete `op` by presenting `token`.
    record await-token {
        op: op-id,
        token: string,
    }

    /// Successful output of a completed operation.
    variant op-output {
        http(http-response),
        sql(sql-result),
        object(list<u8>),
        timer,
        signal(payload),
        child(payload),
        token(payload),
        cancel-requested,
    }

    /// A completed operation.
    record completion {
        op: op-id,
        outcome: result<op-output, failure>,
    }

    /// How `wait` decides it is satisfied.
    enum wait-mode {
        all,
        any,
    }

    http-fetch: func(req: http-request) -> op-id;
    sql-query: func(req: sql-request) -> op-id;
    object-store: func(req: object-request) -> op-id;
    sleep: func(duration-ms: u64) -> op-id;
    sleep-until: func(at: datetime) -> op-id;
    wait-signal: func(name: string, timeout-ms: option<u64>) -> op-id;
    start-child: func(workflow: string, input: payload, opts: child-options) -> op-id;
    create-await-token: func(timeout-ms: option<u64>) -> await-token;
    /// Reserved op that completes with `cancel-requested` once a graceful cancel is
    /// journaled. Terminate is host-only and never guest-visible (WIT-02).
    cancellation: func() -> op-id;
    /// Cancel a pending operation; it completes with `failure::cancelled`.
    cancel-op: func(op: op-id);
    /// Block until the given ops satisfy `mode`. Completions are returned in journaled
    /// order, identical on every replay.
    wait: func(ops: list<op-id>, mode: wait-mode) -> list<completion>;
}

/// Structured logging. Log lines are not journaled; they are suppressed during replay.
interface log {
    enum level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    emit: func(level: level, message: string, fields: list<tuple<string, string>>);
}

/// Exported by every workflow component.
interface workflows {
    use types.{payload, failure};

    /// Static description of a workflow the component provides.
    record workflow-meta {
        name: string,
        version: u32,
        default-queue: option<string>,
        run-timeout-ms: option<u64>,
    }

    /// Continue-as-new request: start a fresh run (same or different workflow) with `input`.
    record continuation {
        input: payload,
        workflow: option<string>,
        version: option<u32>,
    }

    /// Terminal result of a successful `run`.
    variant run-result {
        completed(payload),
        continue-as-new(continuation),
    }

    /// List the workflows this component provides.
    describe: func() -> list<workflow-meta>;
    /// Run the named workflow from the beginning (replaying history as needed).
    run: func(name: string, input: payload) -> result<run-result, failure>;
}

/// The world every Ostro workflow component targets.
world workflow {
    import context;
    import journal;
    import effects;
    import log;
    export workflows;
}
