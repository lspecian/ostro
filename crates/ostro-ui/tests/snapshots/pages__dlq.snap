<main id="main">
<div id="flash" class="flash" role="alert" hidden></div>
<h1>Dead-letter queue</h1>

<nav class="tabs" aria-label="Run views">
<a href="/ui/runs">Runs</a>
<a href="/ui/dlq" aria-current="page">DLQ</a>
</nav>

<form class="filters" method="get" action="/ui/dlq" role="search">
<label>Workflow <input name="workflow" value=""></label>
<label>Queue <input name="queue" value=""></label>
<label>Reason prefix <input name="reason" value=""></label>
<label>Tag <input name="tags" value="" placeholder="key=value"></label>
<label>Dismissed
<select name="include_dismissed">
<option value="false" selected>hide</option>
<option value="true">include</option>
</select>
</label>
<button type="submit">Filter</button>
<a class="button secondary" href="/ui/dlq">Clear</a>
</form>

<table class="dlq">
<thead><tr><th>Run</th><th>Workflow</th><th>Queue</th><th>Status</th><th>Reason</th><th>Failed</th><th>Resumable</th><th>Hook</th><th>State</th><th>Tags</th></tr></thead>
