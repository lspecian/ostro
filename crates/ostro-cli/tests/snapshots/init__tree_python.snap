---
source: crates/ostro-cli/tests/init.rs
expression: s
---
# files
.gitignore
README.md
app.py
ostro.toml
pyproject.toml
target/ostro/sdk/.bundle-id
tests/conftest.py
tests/test_workflow.py

# ostro.toml
# Ostro project manifest (generated by `ostro init`). Unknown keys are rejected.
[project]
name = "hello-wf"
lang = "python"

[build]
# auto | hermetic | system | docker
toolchain = "auto"

[deploy]
activate = true

# pyproject.toml
[project]
name = "hello-wf"
version = "0.1.0"
description = "An Ostro workflow module (generated by `ostro init`)"
requires-python = ">=3.12"
# Workflow modules run inside a WebAssembly component: the `ostro` SDK is staged by
# `ostro build` from target/ostro/sdk/python, so nothing is installed from PyPI.
dependencies = []

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-p no:cacheprovider"
