---
source: crates/ostro-cli/tests/init.rs
expression: s
---
# files
.gitignore
Cargo.toml
README.md
ostro.toml
rust-toolchain.toml
src/lib.rs
target/ostro/sdk/.bundle-id
tests/workflow.rs

# ostro.toml
# Ostro project manifest (generated by `ostro init`). Unknown keys are rejected.
[project]
name = "hello-wf"
lang = "rust"

[build]
# auto | hermetic | system | docker
toolchain = "auto"

[deploy]
activate = true

# Cargo.toml
[package]
name = "hello-wf"
version = "0.1.0"
edition = "2024"
publish = false

# This project is its own cargo workspace; the SDK copies under target/ostro/sdk are
# path dependencies, not members.
[workspace]
exclude = ["target"]

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
# Materialised by `ostro init` / `ostro build` from the SDK bundle embedded in `ostro`
# (until the SDK is published on crates.io).
ostro-sdk = { path = "target/ostro/sdk/rust/ostro-sdk" }
serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.154"

[dev-dependencies]
# The spawned-server test kit (`ostro dev --ephemeral --time-skipping`).
ostro-client = { path = "target/ostro/sdk/rust/ostro-client", features = ["testing"] }
tokio = { version = "1.54", features = ["macros", "rt-multi-thread"] }

[profile.release]
opt-level = "s"
lto = true
strip = true
