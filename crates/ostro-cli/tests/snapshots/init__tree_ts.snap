# ostro.toml
# Ostro project manifest (generated by `ostro init`). Unknown keys are rejected.
[project]
name = "hello-wf"
lang = "ts"

[build]
# auto | hermetic | system | docker
toolchain = "auto"

[deploy]
activate = true

# package.json
{
  "name": "hello-wf",
  "version": "0.1.0",
  "description": "An Ostro workflow module (generated by `ostro init`)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'test/**/*.test.js'"
  }
}
