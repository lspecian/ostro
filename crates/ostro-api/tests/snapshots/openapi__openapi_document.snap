              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/upgrade/hold": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Hold the current feature level (keep the downgrade window open).",
        "operationId": "upgrade_hold",
        "responses": {
          "200": {
            "description": "Upgrade status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpgradeStatus"
                }
