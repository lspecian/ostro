                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/upgrade/release": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Release a hold.",
        "operationId": "upgrade_release",
        "responses": {
          "200": {
            "description": "Upgrade status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpgradeStatus"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
