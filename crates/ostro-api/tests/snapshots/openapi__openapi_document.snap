    "/v1/runs/{run_id}/logs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "A run's recent guest log lines (non-durable, P8-D16).",
        "operationId": "run_logs",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Most recent lines to return (default 100, max 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "level",
            "in": "query",
            "description": "Minimum level.",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Guest log level.",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent lines, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunLogsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/pause": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Pause a run: no further activations until resumed (idempotent).",
        "operationId": "pause_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Optional; an empty body means no detail",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Paused (changed = false on repeats)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPauseState"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
