---
source: crates/ostro-api/tests/openapi.rs
expression: pretty
---
{
  "openapi": "3.1.0",
  "info": {
    "title": "Ostro API",
    "description": "Ostro control plane: modules, workflows and runs. The same operations are served over gRPC (ostro.api.v1) on the same port.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Web UI shell (placeholder until the UI phase).",
        "operationId": "ui_shell",
        "responses": {
          "200": {
            "description": "UI shell",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: always 200.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/hooks/{name}": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Deliver a webhook. The raw body is verified (signature) before anything parses it;\nthere is no other authentication. Body limit: `[triggers] webhook_body_limit`.",
        "operationId": "deliver_hook",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Webhook name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw payload, verified byte-for-byte",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HookPayload"
              }
            },
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/HookPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Delivered (the body depends on the action; a Slack url_verification challenge is echoed as text/plain)"
          },
          "202": {
            "description": "Accepted"
          },
          "401": {
            "description": "Missing or invalid signature"
          },
          "404": {
            "description": "Unknown webhook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds triggers.webhook_body_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "The OpenAPI document of this API.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: 200 iff meta has a leader and every partition is ready.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/backup": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Download an online backup (tar of the bottomless layout, P8-D7).",
        "operationId": "backup",
        "responses": {
          "200": {
            "description": "Tar stream",
            "content": {
              "application/x-tar": {
                "schema": {
                  "$ref": "#/components/schemas/BackupTar"
                }
              }
            }
          },
          "404": {
            "description": "Admin API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Backup not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/connections": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "List connections.",
        "operationId": "list_connections",
        "responses": {
          "200": {
            "description": "Connections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/connections/{name}": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "One connection.",
        "operationId": "get_connection",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Connection name, percent-decoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "connectors"
        ],
        "summary": "Create or replace a connection.",
        "operationId": "put_connection",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Connection name, percent-decoded (http-target names are origins)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutConnectionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionDto"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or invalid config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "connectors"
        ],
        "summary": "Delete a connection.",
        "operationId": "delete_connection",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Connection name, percent-decoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Unknown connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/egress": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "List egress policies.",
        "operationId": "list_egress",
        "responses": {
          "200": {
            "description": "Policies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EgressListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/egress/{module}": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "One module's egress policy.",
        "operationId": "get_egress",
        "parameters": [
          {
            "name": "module",
            "in": "path",
            "description": "Tenant-qualified module name (contains `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EgressDto"
                }
              }
            }
          },
          "404": {
            "description": "No policy for this module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "connectors"
        ],
        "summary": "Create or replace a module's egress policy.",
        "operationId": "put_egress",
        "parameters": [
          {
            "name": "module",
            "in": "path",
            "description": "Tenant-qualified module name (contains `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutEgressBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EgressDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid module name or allow entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "connectors"
        ],
        "summary": "Delete a module's egress policy.",
        "operationId": "delete_egress",
        "parameters": [
          {
            "name": "module",
            "in": "path",
            "description": "Tenant-qualified module name (contains `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "No policy for this module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/grants": {
      "get": {
        "tags": [
          "secrets"
        ],
        "summary": "List grants.",
        "operationId": "list_grants",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "description": "Only this module's grants.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Grants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantListResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "secrets"
        ],
        "summary": "Create or replace a secret grant (the id is computed server-side).",
        "operationId": "put_grant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid module, secret name, origin pattern or id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/grants/{id}": {
      "delete": {
        "tags": [
          "secrets"
        ],
        "summary": "Delete a grant.",
        "operationId": "delete_grant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Grant id `secret:<module>:<secret>` (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Unknown grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/modules/{sha256}": {
      "get": {
        "tags": [
          "modules"
        ],
        "summary": "Get a stored module.",
        "operationId": "get_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Lowercase hex sha256",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "modules"
        ],
        "summary": "Upload a Wasm module (content-addressed, idempotent).",
        "operationId": "upload_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Lowercase hex sha256 of the body",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Source language hint (\"rust\", \"python\", \"typescript\").",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "in": "query",
            "description": "Uploading tenant (`^[a-z0-9][a-z0-9-]{0,62}$`); absent = the default tenant.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Deployed module name (`^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`), recorded on the\nworkflow versions this upload registers.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw Wasm component bytes",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/WasmBytes"
              }
            },
            "application/wasm": {
              "schema": {
                "$ref": "#/components/schemas/WasmBytes"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Module already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadModuleResponse"
                }
              }
            }
          },
          "201": {
            "description": "Module stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadModuleResponse"
                }
              }
            }
          },
          "400": {
            "description": "sha256 mismatch or invalid module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Workflow version registered by another module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Module exceeds api.max_module_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/objects/{connection}/{key}": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "Download through a locally presigned URL. Not behind API authentication: the\nsignature is the authorisation.",
        "operationId": "get_presigned_object",
        "parameters": [
          {
            "name": "connection",
            "in": "path",
            "description": "Object connection name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "path",
            "description": "Object key (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "description": "Expiry, Unix seconds.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "sig",
            "in": "query",
            "description": "Hex signature.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBytes"
                }
              }
            }
          },
          "400": {
            "description": "Missing exp or sig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Bad or expired signature"
          },
          "404": {
            "description": "Unknown object"
          }
        }
      },
      "put": {
        "tags": [
          "connectors"
        ],
        "summary": "Upload through a locally presigned URL. Not behind API authentication: the\nsignature is the authorisation.",
        "operationId": "put_presigned_object",
        "parameters": [
          {
            "name": "connection",
            "in": "path",
            "description": "Object connection name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "path",
            "description": "Object key (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "description": "Expiry, Unix seconds.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "sig",
            "in": "query",
            "description": "Hex signature.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Object bytes",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/ObjectBytes"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored"
          },
          "400": {
            "description": "Missing exp or sig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Bad or expired signature"
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/queues/{name}/demand": {
      "get": {
        "tags": [
          "queues"
        ],
        "summary": "A queue's worker demand (the KEDA scaling signal, D-W12).",
        "operationId": "queue_demand",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Demand snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemandSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid queue name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/queues/{name}/flow": {
      "get": {
        "tags": [
          "queues"
        ],
        "summary": "A queue's flow configuration and record version.",
        "operationId": "get_queue_flow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow configuration (version 0 = never stored)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueFlowInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid queue name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "queues"
        ],
        "summary": "Replace a queue's flow configuration (placement, selector, spill, concurrency,\nweight, throttles, rate limits, auto-pause, paused). CAS: body `expected_version`\nor `If-Match` (both given = they must agree).",
        "operationId": "put_queue_flow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Expected record version (alternative to expected_version)",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutQueueFlowBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored flow configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueFlowInfo"
                }
              }
            }
