          {
            "name": "traceparent",
            "in": "header",
            "description": "W3C traceparent (00-<trace-id>-<parent-id>-<flags>); used when the body's traceparent is empty. Invalid: 400, details.reason = invalid_traceparent",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Existing run returned (idempotency key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunResponse"
                }
              }
            }
          },
          "201": {
            "description": "Run created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow or version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key used (conflict_policy=reject); details.existing_run_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "Workflow has no active version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivateWorkflowBody": {
        "type": "object",
        "description": "Activation body.",
        "required": [
          "version"
        ],
        "properties": {
          "expected_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Required current record version (alternatively the `If-Match` header).",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version to activate.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "BackupTar": {
        "type": "string",
        "format": "binary",
        "description": "Tar archive (documentation-only schema of the backup download)."
      },
      "CancelResponseDto": {
        "type": "object",
        "description": "Cancel result.",
        "required": [
          "already_requested",
          "dry_run"
        ],
        "properties": {
          "already_requested": {
            "type": "boolean",
            "description": "Cancellation had already been requested."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          }
        }
      },
      "CatchupPolicyDto": {
        "type": "string",
        "description": "Which missed fires are started after downtime. Numbering\n([`CatchupPolicyDto::as_u8`]) equals the meta `CATCHUP_*` constants (05-07).",
        "enum": [
          "skip",
          "one",
          "all"
        ]
      },
      "CompleteTokenBody": {
        "type": "object",
        "description": "Await-token completion body. The token travels only here, never in a URL.",
        "required": [
          "token"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only (format, MAC, op still open); nothing is submitted."
          },
          "payload": {
            "description": "Completion payload (any JSON value; defaults to null)."
          },
          "token": {
            "type": "string",
            "description": "The `ot1_...` token."
          }
        },
        "additionalProperties": false
      },
      "CompleteTokenResponseDto": {
        "type": "object",
        "description": "Await-token completion result.",
        "required": [
          "run_id",
          "accepted",
          "dry_run"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The completion was (or would be) accepted."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "run_id": {
            "type": "string",
            "description": "The run the token belongs to."
          }
        }
      },
      "ConflictPolicyDto": {
        "type": "string",
        "description": "Idempotency-key collision policy.",
        "enum": [
          "return_existing",
          "reject"
        ]
      },
      "DeletedDto": {
        "type": "object",
        "description": "Delete result.",
        "required": [
          "name",
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Always true on success."
          },
          "name": {
            "type": "string",
            "description": "Deleted record name."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "REST error envelope.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail",
            "description": "The error."
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "description": "REST error payload.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "snake_case code: invalid_argument, not_found, conflict, precondition_failed,\npayload_too_large, unavailable, internal, unimplemented."
          },
          "details": {
            "description": "Structured details, when present."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          }
        }
      },
      "HistoryEventDto": {
        "type": "object",
        "description": "One history event.",
        "required": [
          "seq",
          "kind",
          "ts",
          "ts_ms",
          "summary",
          "details"
        ],
        "properties": {
          "details": {
            "description": "Details (embedded JSON)."
          },
          "kind": {
            "type": "string",
            "description": "Kind."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Journal seq.",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "description": "One-line summary."
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "description": "Event time (RFC 3339)."
          },
          "ts_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Event time, ms since the Unix epoch.",
            "minimum": 0
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "description": "History page.",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEventDto"
            },
            "description": "Events, ascending seq."
          },
          "next_from_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "`from_seq` of the next page, if any.",
            "minimum": 0
          }
        }
      },
      "HookPayload": {
        "type": "string",
        "format": "binary",
        "description": "Raw webhook payload (documentation-only schema of the hook body)."
      },
      "ListWorkflowsResponse": {
        "type": "object",
        "description": "Workflow listing.",
        "required": [
          "workflows"
        ],
        "properties": {
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowDto"
            },
            "description": "Workflows by name."
          }
        }
      },
      "LogLevelDto": {
        "type": "string",
        "description": "Guest log level.",
        "enum": [
          "trace",
          "debug",
          "info",
          "warn",
          "error"
        ]
      },
      "ModuleDto": {
        "type": "object",
        "description": "A stored module.",
        "required": [
          "sha256",
          "size_bytes",
          "workflows",
          "uploaded_at",
          "uploaded_at_ms"
        ],
        "properties": {
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source language, when known."
          },
          "sha256": {
            "type": "string",
            "description": "Lowercase hex sha256."
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Size in bytes.",
            "minimum": 0
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "description": "Upload time (RFC 3339)."
          },
          "uploaded_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Upload time, ms since the Unix epoch.",
            "minimum": 0
          },
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowRefDto"
            },
            "description": "Exported workflows."
          }
        }
      },
      "OverlapPolicyDto": {
        "type": "string",
        "description": "What a fire does when the previous run of the schedule is still open. Numbering\n([`OverlapPolicyDto::as_u8`]) equals the meta `OVERLAP_*` constants (05-07).",
        "enum": [
          "skip",
          "buffer_one",
          "allow_all",
          "cancel_other",
          "terminate_other"
        ]
      },
      "RetryBody": {
        "type": "object",
        "description": "Retry body (the whole body is optional).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; reports the mode the retry would use."
          }
        },
        "additionalProperties": false
      },
      "RetryModeDto": {
        "type": "string",
        "description": "How a retry was carried out.",
        "enum": [
          "resumed",
          "restarted"
        ]
      },
      "RetryResponseDto": {
        "type": "object",
        "description": "Retry result.",
        "required": [
          "mode",
          "run_id",
          "dry_run"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "mode": {
            "$ref": "#/components/schemas/RetryModeDto",
            "description": "Resume or restart."
          },
          "run_id": {
            "type": "string",
            "description": "The resumed run, or the new run (`restarted`; the original id for dry_run)."
          }
        }
      },
      "RunByDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "JSON pointer to the run id in the body.",
            "required": [
              "run_id_pointer"
            ],
            "properties": {
              "run_id_pointer": {
                "type": "string",
                "description": "JSON pointer to the run id in the body."
              }
            }
          },
          {
            "type": "object",
            "description": "JSON pointer to the start idempotency key in the body.",
            "required": [
              "idempotency_pointer"
            ],
            "properties": {
              "idempotency_pointer": {
                "type": "string",
                "description": "JSON pointer to the start idempotency key in the body."
              }
            }
          }
        ],
        "description": "How a signal webhook finds its run."
      },
      "RunDto": {
        "type": "object",
        "description": "Full run view.",
        "required": [
          "run_id",
          "workflow",
          "version",
          "module_sha256",
          "queue",
          "status",
          "tags",
          "priority",
          "created_at",
          "created_at_ms"
        ],
        "properties": {
          "attempt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Current attempt.",
            "minimum": 0
          },
          "attempt_failures": {
            "type": "integer",
            "format": "int32",
            "description": "Durable count of retryable attempt failures: the meaningful retry count\n(`attempt` counts dispatches, including resumes).",
            "minimum": 0
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Completion time (RFC 3339)."
          },
          "completed_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Completion time, ms since the Unix epoch.",
            "minimum": 0
          },
          "concurrency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Concurrency key."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (RFC 3339)."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time, ms since the Unix epoch.",
            "minimum": 0
          },
          "failure": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failure message."
          },
          "module_sha256": {
            "type": "string",
            "description": "Implementing module."
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Priority."
          },
          "published_status": {
            "description": "Latest published status (embedded JSON)."
          },
          "queue": {
            "type": "string",
            "description": "Queue."
          },
          "result": {
            "description": "Result of a completed run (embedded JSON)."
          },
          "retention_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Resolved retention of the terminal run, ms (absent = keep forever).",
            "minimum": 0
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          },
          "schedule_to_start_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Resolved schedule-to-start timeout, ms (absent = none).",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant."
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C traceparent."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow."
          }
        }
      },
      "RunListResponse": {
        "type": "object",
        "description": "A page of runs.",
        "required": [
          "runs"
        ],
        "properties": {
          "next_page_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Token for the next page, if any."
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunSummaryDto"
            },
            "description": "Runs."
          }
        }
      },
      "RunLogLine": {
        "type": "object",
        "description": "One guest log line.",
        "required": [
          "ts_ms",
          "level",
          "message",
          "fields",
          "attempt"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32",
            "description": "Attempt that emitted the line.",
            "minimum": 0
          },
          "fields": {
            "description": "Structured fields (a JSON object)."
          },
          "level": {
            "$ref": "#/components/schemas/LogLevelDto",
            "description": "Level."
          },
          "message": {
            "type": "string",
            "description": "Message."
          },
          "ts_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Emission time, ms since the Unix epoch.",
            "minimum": 0
          }
        }
      },
      "RunLogsResponse": {
        "type": "object",
        "description": "A run's recent guest log lines (non-durable ring buffer, P8-D16).",
        "required": [
          "run_id",
          "lines",
          "dropped"
        ],
        "properties": {
          "dropped": {
            "type": "integer",
            "format": "int64",
            "description": "Lines dropped for this run by rate limits, caps or ring eviction (best effort).",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunLogLine"
            },
            "description": "Lines, oldest first."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "RunPolicyBody": {
        "type": "object",
        "description": "Run policy body: friendly durations (`168h`, `30s`; write days as hours).\nOmitted fields are cleared (PUT replaces the whole policy).",
        "properties": {
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention of terminal runs and their journals."
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout for the initial start."
          }
        },
        "additionalProperties": false
      },
      "RunPolicyDto": {
        "type": "object",
        "description": "A stored run policy (unset = no override at this level).",
        "properties": {
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention as a friendly duration."
          },
          "retention_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Retention in ms.",
            "minimum": 0
          },
          "schedule_to_start_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Schedule-to-start timeout in ms.",
            "minimum": 0
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout as a friendly duration."
          }
        }
      },
      "RunResultDto": {
        "type": "object",
        "description": "Long-poll result (200 whether or not the run is terminal).",
        "required": [
          "run_id",
          "status",
          "completed"
        ],
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "True when `status` is terminal."
          },
          "failure": {
            "description": "Failure of a failed run (absent otherwise)."
          },
          "result": {
            "description": "Result of a completed run (absent otherwise)."
          },
          "run_id": {
            "type": "string",
            "description": "The run answered for (the last successor when following continuations)."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Current status."
          }
        }
      },
      "RunStatusDto": {
        "type": "string",
        "description": "Run status.",
        "enum": [
          "scheduled",
          "ready",
          "running",
          "completed",
          "failed",
          "cancelled",
          "terminated",
          "timed_out",
          "continued_as_new"
        ]
      },
      "RunSummaryDto": {
        "type": "object",
        "description": "Run listing row.",
        "required": [
          "run_id",
          "workflow",
          "version",
          "status",
          "queue",
          "created_at",
          "created_at_ms",
          "tags"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (RFC 3339)."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time, ms since the Unix epoch.",
            "minimum": 0
          },
          "queue": {
            "type": "string",
            "description": "Queue."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow."
          }
        }
      },
      "ScheduleDto": {
        "type": "object",
        "description": "A cron schedule (meta `Schedule`). On PUT the name comes from the path (a body name\nmust match it); `version_tag` is the CAS input on PUT and the stored record version\non output; `next_fire_at_ms` / `last_fire_at_ms` are output only.",
        "properties": {
          "catchup": {
            "$ref": "#/components/schemas/CatchupPolicyDto",
            "description": "Catch-up policy."
          },
          "catchup_window_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "How far back missed fires are considered, ms (unset or 0 = server default).",
            "minimum": 0
          },
          "cron": {
            "type": "string",
            "description": "Cron expression."
          },
          "end_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "No fire after this time (ms since the Unix epoch).",
            "minimum": 0
          },
          "input": {
            "description": "Run input (any JSON value; defaults to null)."
          },
          "last_fire_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Last fire time (output only).",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Schedule name (`[A-Za-z0-9_.-]{1,128}`)."
          },
          "next_fire_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Next fire time, computed by the server (output only).",
            "minimum": 0
          },
          "overlap": {
            "$ref": "#/components/schemas/OverlapPolicyDto",
            "description": "Overlap policy."
          },
          "paused": {
            "type": "boolean",
            "description": "Paused schedules do not fire."
          },
          "start_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "No fire before this time (ms since the Unix epoch).",
            "minimum": 0
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone; empty = UTC."
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Workflow version (unset = the active version at fire time).",
            "minimum": 0
          },
          "version_tag": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Meta record version (CAS input on PUT).",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow to start."
          }
        },
        "additionalProperties": false
      },
      "ScheduleListResponse": {
        "type": "object",
        "description": "Schedule listing.",
        "required": [
          "schedules"
        ],
        "properties": {
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleDto"
            },
            "description": "Every schedule, by name."
          }
        }
      },
      "SignalBody": {
        "type": "object",
        "description": "Signal body.",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; nothing is submitted."
          },
          "payload": {
            "description": "Signal payload (any JSON value; defaults to null)."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional dedupe id (<= 64 bytes): a repeat is acknowledged with\n`duplicate: true` and not delivered again."
          }
        },
        "additionalProperties": false
      },
      "SignalResponseDto": {
        "type": "object",
        "description": "Signal result.",
        "required": [
          "accepted",
          "duplicate",
          "dry_run"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The signal was (or would be) accepted."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "duplicate": {
            "type": "boolean",
            "description": "`request_id` was already seen for this run."
          }
        }
      },
      "StartRunBody": {
        "type": "object",
        "description": "Start-run body.",
        "properties": {
          "concurrency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Concurrency key."
          },
          "conflict_policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ConflictPolicyDto",
                "description": "Collision policy (default `return_existing`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "delay_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Delay before the run becomes ready, ms.",
            "minimum": 0
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate only: the same checks as a real start, nothing is submitted. The response\nreports the would-be outcome (`run_id` = the existing run for a reused idempotency\nkey, else empty)."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Idempotency key."
          },
          "input": {
            "description": "Workflow input (any JSON value; defaults to null)."
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Priority."
          },
          "queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Queue override."
          },
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention override for the terminal run (friendly duration in hours or smaller\nunits, e.g. `\"168h\"`; `7d` is rejected). Unset: workflow policy, queue policy, then\nthe server's `[runs] retention`."
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout override (friendly duration, e.g. `\"30s\"`; `\"0s\"` = none).\nUnset: the workflow policy, then the queue policy."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant."
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C traceparent."
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Explicit version (else the active one).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "StartRunResponse": {
        "type": "object",
        "description": "Start-run result.",
        "required": [
          "run_id",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "`false` when an existing run was returned."
          },
          "dry_run": {
            "type": "boolean",
            "description": "`true` for a dry run (omitted otherwise). A dry run returns the existing run's id\nfor a reused idempotency key, else an empty `run_id`."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "StopRunBody": {
        "type": "object",
        "description": "Cancel / terminate body (the whole body is optional).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; nothing is submitted."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason (<= 1024 bytes), recorded in history."
          }
        },
        "additionalProperties": false
      },
      "TerminateResponseDto": {
        "type": "object",
        "description": "Terminate result.",
        "required": [
          "status",
          "dry_run"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status afterwards (`terminated`)."
          }
        }
      },
      "TriggerScheduleBody": {
        "type": "object",
        "description": "Manual trigger body (optional).",
        "properties": {
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Idempotency of the manual fire (1..=64 bytes): a repeat returns the same run."
          }
        },
        "additionalProperties": false
      },
      "TriggerScheduleResponseDto": {
        "type": "object",
        "description": "Manual trigger result.",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "description": "The started (or deduplicated) run."
          }
        }
      },
      "UploadModuleResponse": {
        "type": "object",
        "description": "Upload result.",
        "required": [
          "module",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "`false` on idempotent re-upload."
          },
          "module": {
            "$ref": "#/components/schemas/ModuleDto",
            "description": "The stored module."
          }
        }
      },
      "VerifierDto": {
        "type": "object",
        "description": "Signature verifier. The secret is never returned: `secret_ref` names a sealed\nsecret.",
        "properties": {
          "algorithm": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: `sha256` (default) or `legacy_sha1`."
          },
          "encoding": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: `hex` or `base64`."
          },
          "header": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signature header."
          },
          "kind": {
            "$ref": "#/components/schemas/VerifierKindDto",
            "description": "Kind."
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signature prefix (e.g. `sha256=`)."
          },
          "secret_ref": {
            "type": "string",
            "description": "Sealed secret name (required unless kind = none)."
          },
          "template": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signed template (`{body}` or `{ts}.{body}`)."
          },
          "timestamp_header": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: timestamp header."
          },
          "tolerance_s": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Replay window, seconds (unset = the verifier default).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "VerifierKindDto": {
        "type": "string",
        "description": "Signature verifier kind.",
        "enum": [
          "none",
          "stripe",
          "github",
          "slack",
          "standard",
          "hmac"
        ]
      },
      "WasmBytes": {
        "type": "string",
        "format": "binary",
        "description": "Raw Wasm component bytes (documentation-only schema of the upload body)."
      },
      "WebhookActionDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "Start a run (idempotency key = the delivery key, conflict policy return-existing).",
            "required": [
              "workflow",
              "kind"
            ],
            "properties": {
              "input": {
                "type": "string",
                "description": "`\"body\"` (the whole body) or a JSON pointer into it."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "start"
                ]
              },
              "version": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int32",
                "description": "Version (unset = active).",
                "minimum": 0
              },
              "workflow": {
                "type": "string",
                "description": "Workflow."
              }
            }
          },
          {
            "type": "object",
            "description": "Signal a run (request id = the delivery key).",
            "required": [
              "workflow",
              "run_by",
              "name",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "signal"
                ]
              },
              "name": {
                "type": "string",
                "description": "Signal name."
              },
              "run_by": {
                "$ref": "#/components/schemas/RunByDto",
                "description": "How the run is found."
              },
              "workflow": {
                "type": "string",
                "description": "Workflow of the target run."
              }
            }
          },
          {
            "type": "object",
            "description": "Complete an await token.",
            "required": [
              "token_pointer",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "complete_token"
                ]
              },
              "token_pointer": {
                "type": "string",
                "description": "JSON pointer to the token in the body."
              }
            }
          }
        ],
        "description": "What a verified delivery does."
      },
      "WebhookDto": {
        "type": "object",
        "description": "An inbound webhook (meta `Webhook`).",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/WebhookActionDto",
            "description": "Action."
          },
          "idempotency": {
            "type": [
              "string",
              "null"
            ],
            "description": "`header:<name>`, `json:<pointer>` or `none` (unset = the verifier's default)."
          },
          "name": {
            "type": "string",
            "description": "Webhook name (`[A-Za-z0-9_.-]{1,128}`), the `{name}` of `POST /hooks/{name}`."
          },
          "verifier": {
            "$ref": "#/components/schemas/VerifierDto",
            "description": "Verifier."
          },
          "version_tag": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Meta record version (CAS input on PUT).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "WebhookListResponse": {
        "type": "object",
        "description": "Webhook listing.",
        "required": [
          "webhooks"
        ],
        "properties": {
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDto"
            },
            "description": "Every webhook, by name."
          }
        }
      },
      "WorkflowDto": {
        "type": "object",
        "description": "A workflow.",
        "required": [
          "name",
          "versions",
          "record_version"
        ],
        "properties": {
          "active_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Active version.",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "record_version": {
            "type": "integer",
            "format": "int64",
            "description": "Record version (CAS token for activation; also accepted via `If-Match`).",
            "minimum": 0
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowVersionDto"
            },
            "description": "Versions, ascending."
          }
        }
      },
      "WorkflowRefDto": {
        "type": "object",
        "description": "Workflow name + version.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Workflow name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Workflow version.",
            "minimum": 0
          }
        }
      },
      "WorkflowVersionDto": {
        "type": "object",
        "description": "One workflow version.",
        "required": [
          "version",
          "module_sha256"
        ],
        "properties": {
          "default_queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default queue."
          },
          "module_sha256": {
            "type": "string",
            "description": "Implementing module."
          },
          "run_timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Default run timeout in ms.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "modules",
      "description": "Wasm module storage"
    },
    {
      "name": "workflows",
      "description": "Workflow versions and activation"
    },
    {
      "name": "runs",
      "description": "Starting and inspecting runs"
    },
    {
      "name": "tokens",
      "description": "Await-token completion"
    },
    {
      "name": "queues",
      "description": "Queue run policies"
    },
    {
      "name": "schedules",
      "description": "Cron schedules (Phase 8)"
    },
    {
      "name": "webhooks",
      "description": "Inbound webhooks: definitions and POST /hooks/{name} (Phase 8)"
    },
    {
      "name": "admin",
      "description": "Online backup (Phase 8)"
    },
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "meta",
      "description": "API document and UI shell"
    }
  ]
}
