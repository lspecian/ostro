    "/v1/workflows": {
      "get": {
        "tags": [
          "workflows"
        ],
        "summary": "List workflows.",
        "operationId": "list_workflows",
        "responses": {
          "200": {
            "description": "All workflows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListWorkflowsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{name}/active": {
      "put": {
        "tags": [
          "workflows"
        ],
        "summary": "Activate a workflow version.",
        "operationId": "activate_workflow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Expected record version (alternative to expected_version)",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateWorkflowBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated workflow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow or version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "Record version mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{name}/pause": {
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "Pause a workflow: its runs get no new activations (idempotent).",
        "operationId": "pause_workflow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paused (changed = false on repeats)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PauseState"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{name}/policy": {
      "get": {
        "tags": [
          "workflows"
        ],
        "summary": "A workflow's run policy.",
        "operationId": "get_workflow_policy",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored policy (all null when never set)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPolicyDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "workflows"
        ],
        "summary": "Replace a workflow's run policy (future runs only).",
        "operationId": "set_workflow_policy",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunPolicyBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPolicyDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid duration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{name}/resume": {
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "Resume a paused workflow (idempotent).",
        "operationId": "resume_workflow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumed (changed = false on repeats)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PauseState"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{name}/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Start a run.",
        "operationId": "start_run",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "description": "W3C traceparent (00-<trace-id>-<parent-id>-<flags>); used when the body's traceparent is empty. Invalid: 400, details.reason = invalid_traceparent",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Existing run returned (idempotency key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunResponse"
                }
              }
            }
          },
          "201": {
            "description": "Run created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow or version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key used (conflict_policy=reject); details.existing_run_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "Workflow has no active version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivateWorkflowBody": {
        "type": "object",
        "description": "Activation body.",
        "required": [
          "version"
        ],
        "properties": {
          "expected_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Required current record version (alternatively the `If-Match` header).",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version to activate.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "BackupTar": {
        "type": "string",
        "format": "binary",
        "description": "Tar archive (documentation-only schema of the backup download)."
      },
      "CancelResponseDto": {
        "type": "object",
        "description": "Cancel result.",
        "required": [
          "already_requested",
          "dry_run"
        ],
        "properties": {
          "already_requested": {
            "type": "boolean",
            "description": "Cancellation had already been requested."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          }
        }
      },
      "CatchupPolicyDto": {
        "type": "string",
        "description": "Which missed fires are started after downtime. Numbering\n([`CatchupPolicyDto::as_u8`]) equals the meta `CATCHUP_*` constants (05-07).",
        "enum": [
          "skip",
          "one",
          "all"
        ]
      },
      "CompleteTokenBody": {
        "type": "object",
        "description": "Await-token completion body. The token travels only here, never in a URL.",
        "required": [
          "token"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only (format, MAC, op still open); nothing is submitted."
          },
          "payload": {
            "description": "Completion payload (any JSON value; defaults to null)."
          },
          "token": {
            "type": "string",
            "description": "The `ot1_...` token."
          }
        },
        "additionalProperties": false
      },
      "CompleteTokenResponseDto": {
        "type": "object",
        "description": "Await-token completion result.",
        "required": [
          "run_id",
          "accepted",
          "dry_run"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The completion was (or would be) accepted."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "run_id": {
            "type": "string",
            "description": "The run the token belongs to."
          }
        }
      },
      "ConflictPolicyDto": {
        "type": "string",
        "description": "Idempotency-key collision policy.",
        "enum": [
          "return_existing",
          "reject"
        ]
      },
      "ConnectionDto": {
        "type": "object",
        "description": "A connection.",
        "required": [
          "name",
          "kind",
          "config"
        ],
        "properties": {
          "config": {
            "description": "Kind-specific config."
          },
          "kind": {
            "type": "string",
            "description": "Connection kind."
          },
          "name": {
            "type": "string",
            "description": "Connection name."
          }
        }
      },
      "ConnectionListResponse": {
        "type": "object",
        "description": "`GET /v1/connections` response.",
        "required": [
          "connections"
        ],
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionDto"
            },
            "description": "Connections sorted by name."
          }
        }
      },
      "CreateWorkerTokenRequest": {
        "type": "object",
        "description": "`POST /v1/workers/tokens` body (optional).",
        "properties": {
          "ttl_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Token lifetime in ms (> 0); absent = `[workers] join_token_ttl`.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "DeletedDto": {
        "type": "object",
        "description": "Delete result.",
        "required": [
          "name",
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Always true on success."
          },
          "name": {
            "type": "string",
            "description": "Deleted record name."
          }
        }
      },
      "DemandSnapshot": {
        "type": "object",
        "description": "Worker demand of a queue (D-W12): `demand = running_on_workers + admissible\nbacklog for workers` (`embedded` queues: 0; `auto`: the backlog only while\nspilling). The KEDA scaling signal.",
        "required": [
          "queue",
          "demand",
          "backlog",
          "running_on_workers",
          "placement",
          "spilling",
          "workers",
          "worker_slots_free"
        ],
        "properties": {
          "backlog": {
            "type": "integer",
            "format": "int64",
            "description": "Admissible ready entries waiting for a worker.",
            "minimum": 0
          },
          "demand": {
            "type": "integer",
            "format": "int64",
            "description": "Worker slots the queue could use now.",
            "minimum": 0
          },
          "placement": {
            "$ref": "#/components/schemas/Placement",
            "description": "Effective placement."
          },
          "queue": {
            "type": "string",
            "description": "Queue name."
          },
          "running_on_workers": {
            "type": "integer",
            "format": "int64",
            "description": "Activations of the queue running on workers.",
            "minimum": 0
          },
          "spilling": {
            "type": "boolean",
            "description": "`auto` placement is currently spilling to workers."
          },
          "worker_slots_free": {
            "type": "integer",
            "format": "int64",
            "description": "Free worker slots (all workers).",
            "minimum": 0
          },
          "workers": {
            "type": "integer",
            "format": "int64",
            "description": "Connected workers.",
            "minimum": 0
          }
        }
      },
      "DrainResult": {
        "type": "object",
        "description": "`POST /v1/workers/{id}/drain` response.",
        "required": [
          "worker_id",
          "already_draining"
        ],
        "properties": {
          "already_draining": {
            "type": "boolean",
            "description": "True when the worker already was draining."
          },
          "worker_id": {
            "type": "string",
            "description": "Worker id."
          }
        }
      },
      "EgressDto": {
        "type": "object",
        "description": "A module's egress policy.",
        "required": [
          "module",
          "allow"
        ],
        "properties": {
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origin patterns or `connection:<name>` entries."
          },
          "module": {
            "type": "string",
            "description": "Tenant-qualified deployed module name."
          }
        }
      },
      "EgressListResponse": {
        "type": "object",
        "description": "`GET /v1/egress` response.",
        "required": [
          "policies"
        ],
        "properties": {
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EgressDto"
            },
            "description": "Policies sorted by module."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "REST error envelope.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail",
            "description": "The error."
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "description": "REST error payload.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "snake_case code: invalid_argument, not_found, conflict, precondition_failed,\npayload_too_large, unavailable, internal, unimplemented."
          },
          "details": {
            "description": "Structured details, when present."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          }
        }
      },
      "ExhaustAction": {
        "type": "string",
        "description": "What happens when a run exhausts its retries.",
        "enum": [
          "fail",
          "pause"
        ]
      },
      "GrantDto": {
        "type": "object",
        "description": "An origin-bound secret grant.",
        "required": [
          "module",
          "secret",
          "origins"
        ],
        "properties": {
          "body": {
            "type": "boolean",
            "description": "Placeholders allowed in the request body."
          },
          "id": {
            "type": "string",
            "description": "`secret:<module>:<secret>`; computed server-side (may be omitted on PUT)."
          },
          "module": {
            "type": "string",
            "description": "Tenant-qualified deployed module name (`<tenant>/<name>`)."
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origin patterns (`scheme://host[:port]`, `scheme://*.domain[:port]`)."
          },
          "secret": {
            "type": "string",
            "description": "Secret name."
          }
        }
      },
      "GrantListResponse": {
        "type": "object",
        "description": "`GET /v1/grants` response.",
        "required": [
          "grants"
        ],
        "properties": {
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantDto"
            },
            "description": "Grants sorted by id."
          }
        }
      },
      "HistoryEventDto": {
        "type": "object",
        "description": "One history event.",
        "required": [
          "seq",
          "kind",
          "ts",
          "ts_ms",
          "summary",
          "details"
        ],
        "properties": {
          "details": {
            "description": "Details (embedded JSON)."
          },
          "kind": {
            "type": "string",
            "description": "Kind."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Journal seq.",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "description": "One-line summary."
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "description": "Event time (RFC 3339)."
          },
          "ts_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Event time, ms since the Unix epoch.",
            "minimum": 0
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "description": "History page.",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEventDto"
            },
            "description": "Events, ascending seq."
          },
          "next_from_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "`from_seq` of the next page, if any.",
            "minimum": 0
          }
        }
      },
      "HookPayload": {
        "type": "string",
        "format": "binary",
        "description": "Raw webhook payload (documentation-only schema of the hook body)."
      },
      "JoinRequest": {
        "type": "object",
        "description": "`POST /v1/workers/join` body: the 07-07 worker's join contract. `Debug` redacts\nthe token.",
        "required": [
          "token",
          "csr_pem",
          "worker_id"
        ],
        "properties": {
          "csr_pem": {
            "type": "string",
            "description": "PEM PKCS#10 CSR of a key generated in the worker's memory."
          },
          "labels": {
            "type": "object",
            "description": "Worker labels (keys: selector keys; values: selector values).",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "token": {
            "type": "string",
            "description": "`wkr_<id>.<secret>`."
          },
          "worker_id": {
            "type": "string",
            "description": "Worker id: 1..=128 bytes of `[A-Za-z0-9_.:-]`."
          }
        },
        "additionalProperties": false
      },
      "JoinResponse": {
        "type": "object",
        "description": "`POST /v1/workers/join` response.",
        "required": [
          "client_cert_pem",
          "ca_cert_pem",
          "endpoints",
          "renew_after_ms",
          "cluster_id"
        ],
        "properties": {
          "ca_cert_pem": {
            "type": "string",
            "description": "PEM cluster CA certificate."
          },
          "client_cert_pem": {
            "type": "string",
            "description": "PEM client certificate (SAN URI `ostro://<cluster>/worker/<token_id>/<worker_id>`)."
          },
          "cluster_id": {
            "type": "string",
            "description": "Cluster id."
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Cluster listener endpoints (`host:port`)."
          },
          "renew_after_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Renew the certificate after this many ms.",
            "minimum": 0
          }
        }
      },
      "ListWorkflowsResponse": {
        "type": "object",
        "description": "Workflow listing.",
        "required": [
          "workflows"
        ],
        "properties": {
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowDto"
            },
            "description": "Workflows by name."
          }
        }
      },
      "LogLevelDto": {
        "type": "string",
        "description": "Guest log level.",
        "enum": [
          "trace",
          "debug",
          "info",
          "warn",
          "error"
        ]
      },
      "ModuleDto": {
        "type": "object",
        "description": "A stored module.",
        "required": [
          "sha256",
          "size_bytes",
          "workflows",
          "uploaded_at",
          "uploaded_at_ms"
        ],
        "properties": {
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source language, when known."
          },
          "sha256": {
            "type": "string",
            "description": "Lowercase hex sha256."
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Size in bytes.",
            "minimum": 0
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "description": "Upload time (RFC 3339)."
          },
          "uploaded_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Upload time, ms since the Unix epoch.",
            "minimum": 0
          },
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowRefDto"
            },
            "description": "Exported workflows."
          }
        }
      },
      "ObjectBytes": {
        "type": "string",
        "format": "binary",
        "description": "Object bytes (documentation-only schema of presigned object bodies)."
      },
      "OverlapPolicyDto": {
        "type": "string",
        "description": "What a fire does when the previous run of the schedule is still open. Numbering\n([`OverlapPolicyDto::as_u8`]) equals the meta `OVERLAP_*` constants (05-07).",
        "enum": [
          "skip",
          "buffer_one",
          "allow_all",
          "cancel_other",
          "terminate_other"
        ]
      },
      "PauseRunRequest": {
        "type": "object",
        "description": "`POST /v1/runs/{run_id}/pause` body (optional).",
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Operator note stored with the pause mark (at most 1024 bytes)."
          }
        },
        "additionalProperties": false
      },
      "PauseState": {
        "type": "object",
        "description": "Pause state of a queue or workflow after a pause/resume call.",
        "required": [
          "name",
          "paused",
          "changed"
        ],
        "properties": {
          "changed": {
            "type": "boolean",
            "description": "False when it already was in the requested state (idempotent repeat)."
          },
          "name": {
            "type": "string",
            "description": "Queue or workflow name."
          },
          "paused": {
            "type": "boolean",
            "description": "Paused after the call."
          }
        }
      },
      "Placement": {
        "type": "string",
        "description": "Where a queue's runs execute.",
        "enum": [
          "embedded",
          "workers",
          "auto"
        ]
      },
      "PutConnectionBody": {
        "type": "object",
        "description": "`PUT /v1/connections/{name}` body.",
        "required": [
          "kind",
          "config"
        ],
        "properties": {
          "config": {
            "description": "Kind-specific config object with `\"v\": 1`; secrets only as `{{secret:NAME}}`."
          },
          "kind": {
            "type": "string",
            "description": "`sql-postgres`, `sql-mysql`, `object` or `http-target`."
          }
        },
        "additionalProperties": false
      },
      "PutEgressBody": {
        "type": "object",
        "description": "`PUT /v1/egress/{module}` body.",
        "required": [
          "allow"
        ],
        "properties": {
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origin patterns or `connection:<name>` entries."
          }
        },
        "additionalProperties": false
      },
      "PutQueueFlowBody": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QueueFlow",
            "description": "The flow configuration (replaces every flow field)."
          },
          {
            "type": "object",
            "properties": {
              "expected_version": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "description": "The `version` the caller read; a stale value answers 412.",
                "minimum": 0
              }
            }
          }
        ],
        "description": "`PUT /v1/queues/{name}/flow` body: the flow fields plus an optional CAS version."
      },
      "PutSecretBody": {
        "type": "object",
        "description": "`PUT /v1/secrets/{name}` body: exactly one of `value` (UTF-8) or `value_b64`\n(standard base64, padding optional). Write-only.",
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ],
            "description": "The value as UTF-8 text.",
            "writeOnly": true
          },
          "value_b64": {
            "type": [
              "string",
              "null"
            ],
            "description": "The value as standard base64.",
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "QueueFlow": {
        "type": "object",
        "description": "A queue's flow configuration (stored in the meta `QueuePolicy` Phase 7 fields).\nAbsent fields mean no limit or the server default.",
        "properties": {
          "concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Maximum concurrently running activations of the queue.",
            "minimum": 0
          },
          "key_concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Maximum concurrently running activations per concurrency key.",
            "minimum": 0
          },
          "key_rate_limit": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RateSpecDto",
                "description": "Run-start rate limit per concurrency key."
              },
              {
                "type": "null"
              }
            ]
          },
          "key_throttle": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RateSpecDto",
                "description": "Activation start throttle per concurrency key."
              },
              {
                "type": "null"
              }
            ]
          },
          "on_retries_exhausted": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ExhaustAction",
                "description": "What happens when a run exhausts its retries; absent = `fail`."
              },
              {
                "type": "null"
              }
            ]
          },
          "paused": {
            "type": "boolean",
            "description": "The queue is paused (no new activations are granted)."
          },
          "placement": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Placement",
                "description": "Placement; absent = `[workers] default_placement`."
              },
              {
                "type": "null"
              }
            ]
          },
          "rate_limit": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RateSpecDto",
                "description": "Run-start rate limit of the queue (excess starts answer 429 `rate_limited`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "selector": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Worker label selector requirements, ANDed (see the module docs for the\ngrammar): at most 32 entries of at most 128 bytes."
          },
          "spill": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SpillPolicyDto",
                "description": "Per-queue spill thresholds for `auto`; absent = `[workers.spill]`."
              },
              {
                "type": "null"
              }
            ]
          },
          "throttle": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RateSpecDto",
                "description": "Activation start throttle of the queue."
              },
              {
                "type": "null"
              }
            ]
          },
          "weight": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Fair-share weight (default `[flow] default_queue_weight`).",
            "minimum": 0
          }
        }
      },
      "QueueFlowInfo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QueueFlow",
            "description": "The flow configuration."
          },
          {
            "type": "object",
