---
source: crates/ostro-api/tests/openapi.rs
expression: pretty
---
{
  "openapi": "3.1.0",
  "info": {
    "title": "Ostro API",
    "description": "Ostro control plane: modules, workflows and runs. The same operations are served over gRPC (ostro.api.v1) on the same port.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Web UI shell, or a redirect to the embedded UI when it is enabled (D-P11-17).",
        "operationId": "ui_shell",
        "responses": {
          "200": {
            "description": "UI shell",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "303": {
            "description": "The embedded UI is enabled: Location /ui/"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: always 200.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/hooks/{name}": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Deliver a webhook. The raw body is verified (signature) before anything parses it;\nthere is no other authentication. Body limit: `[triggers] webhook_body_limit`.",
        "operationId": "deliver_hook",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Webhook name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw payload, verified byte-for-byte",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HookPayload"
              }
            },
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/HookPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Delivered (the body depends on the action; a Slack url_verification challenge is echoed as text/plain)"
          },
          "202": {
            "description": "Accepted"
          },
          "401": {
            "description": "Missing or invalid signature"
          },
          "404": {
            "description": "Unknown webhook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds triggers.webhook_body_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "The OpenAPI document of this API.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: 200 iff meta has a leader and every partition is ready.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/backup": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Download an online backup (tar of the bottomless layout, P8-D7).",
        "operationId": "backup",
        "responses": {
          "200": {
            "description": "Tar stream",
            "content": {
              "application/x-tar": {
                "schema": {
                  "$ref": "#/components/schemas/BackupTar"
                }
              }
            }
          },
          "404": {
            "description": "Admin API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Backup not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bulk": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Every bulk job on this node.",
        "operationId": "list_bulk",
        "responses": {
          "200": {
            "description": "Bulk jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkJobList"
                }
              }
            }
          },
          "404": {
            "description": "Run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "operations"
        ],
        "summary": "Create a bulk job (or count its matches, for dry_run).",
        "operationId": "create_bulk",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dry run: estimate and up to 20 samples",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkCreateResponse"
                }
              }
            }
          },
          "201": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; bulk_too_many_matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "bulk_too_many_jobs (details.retry_after_ms)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bulk/{job_id}": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "One bulk job.",
        "operationId": "get_bulk",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "description": "Job id (blk_...)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkJobView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job, or run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bulk/{job_id}/cancel": {
      "post": {
        "tags": [
          "operations"
        ],
        "summary": "Cancel a bulk job.",
        "operationId": "cancel_bulk",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "description": "Job id (blk_...)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job (state cancelled)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkJobView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job, or run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/init": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Promote this single node to a cluster.",
        "operationId": "init",
        "requestBody": {
          "description": "Optional; an empty body takes the defaults",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cluster status after promotion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Already a cluster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/join": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Admit a joining node. Authenticated by the node join token in the body (no client\nidentity; mounted outside the API middleware).",
        "operationId": "join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClusterJoinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Admitted (Cache-Control: no-store)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterJoinResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or token (details.reason)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "feature_not_enabled / incompatible binary (details.reason)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/members/{id}/drain": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Drain a member: hand off its partition leaderships and replicas.",
        "operationId": "drain",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cluster status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown member, or cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/members/{id}/remove": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Remove a member (`force` skips waiting for a dead node, never the quorum check).",
        "operationId": "remove",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "description": "Optional",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveMemberBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cluster status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown member, or cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Would lose quorum (details.reason)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/reassign": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Start or cancel a partition reassignment.",
        "operationId": "reassign",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReassignRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cluster status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid replica set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Reassignment in progress / not cancellable (details.reason)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/rebalance": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Rebalance replicas and preferred leaders.",
        "operationId": "rebalance",
        "responses": {
          "200": {
            "description": "Cluster status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/status": {
      "get": {
        "tags": [
          "cluster"
        ],
        "summary": "Cluster status: members, meta voters / learners, levels, policy, reassignments.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Cluster status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/tokens": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Create a node join token (`njt_…`). The secret is in this response only.",
        "operationId": "create_node_token",
        "requestBody": {
          "description": "Optional; an empty body means the default lifetime",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created (Cache-Control: no-store)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ttl_secs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Cluster API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cluster/upgrade": {
      "get": {
        "tags": [
