            ],
            "properties": {
              "queue": {
                "type": "string",
                "description": "Queue name."
              },
              "version": {
                "type": "integer",
                "format": "int64",
                "description": "Meta record version (CAS token for `expected_version`); 0 = never stored.",
                "minimum": 0
              }
            }
          }
        ],
        "description": "A queue's flow configuration with its record version."
      },
      "RateSpecDto": {
        "type": "object",
        "description": "`limit` events per `period_ms` (> 0), with `burst` extra tokens.",
        "required": [
          "limit",
          "period_ms"
        ],
        "properties": {
          "burst": {
            "type": "integer",
            "format": "int32",
            "description": "Extra tokens on top of `limit`.",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Events per period.",
            "minimum": 0
          },
          "period_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Period length in ms; must be > 0.",
            "minimum": 0
          }
        }
      },
      "RetryBody": {
        "type": "object",
        "description": "Retry body (the whole body is optional).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; reports the mode the retry would use."
          }
        },
        "additionalProperties": false
      },
      "RetryModeDto": {
        "type": "string",
        "description": "How a retry was carried out.",
        "enum": [
