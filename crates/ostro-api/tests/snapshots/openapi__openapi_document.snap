                }
              }
            }
          }
        }
      }
    },
    "/v1/modules/gc": {
      "post": {
        "tags": [
          "modules"
        ],
        "summary": "Run one module GC round now.",
        "operationId": "run_module_gc",
        "responses": {
          "200": {
            "description": "Round report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GcRunReport"
                }
              }
            }
          },
          "404": {
            "description": "Module lifecycle API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/modules/{sha256}": {
      "get": {
        "tags": [
          "modules"
        ],
        "summary": "Get a stored module.",
        "operationId": "get_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Lowercase hex sha256",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "modules"
        ],
        "summary": "Upload a Wasm module (content-addressed, idempotent).",
        "operationId": "upload_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Lowercase hex sha256 of the body",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Source language hint (\"rust\", \"python\", \"typescript\").",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "in": "query",
            "description": "Uploading tenant (`^[a-z0-9][a-z0-9-]{0,62}$`); absent = the default tenant.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Deployed module name (`^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`), recorded on the\nworkflow versions this upload registers.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw Wasm component bytes",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/WasmBytes"
              }
            },
            "application/wasm": {
              "schema": {
                "$ref": "#/components/schemas/WasmBytes"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Module already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadModuleResponse"
                }
              }
            }
          },
          "201": {
            "description": "Module stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadModuleResponse"
                }
              }
            }
          },
          "400": {
            "description": "sha256 mismatch or invalid module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Workflow version registered by another module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Module exceeds api.max_module_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "modules"
        ],
        "summary": "Retire a module and its workflow versions (refused while a version is active).",
        "operationId": "retire_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Module sha256 (64 lowercase hex digits)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetireModuleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sha",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown module, or module lifecycle API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "A version is active (details.reason)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/modules/{sha}/replay": {
      "post": {
        "tags": [
          "tooling"
        ],
        "summary": "Replay stored journals against a module.",
        "description": "REST-only tooling endpoint (no gRPC). Replays the selected runs' journals against the uploaded module on the server (`ostro replay`); the module need not be active.",
        "operationId": "replay_module",
        "parameters": [
          {
            "name": "sha",
            "in": "path",
            "description": "Lowercase hex sha256 of an uploaded module",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "One verdict per run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed sha, neither or both of runs / sample, or sample > 1000 (details.reason = sample_too_large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown module or run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/objects/{connection}/{key}": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "Download through a locally presigned URL. Not behind API authentication: the\nsignature is the authorisation.",
        "operationId": "get_presigned_object",
        "parameters": [
          {
            "name": "connection",
            "in": "path",
            "description": "Object connection name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "path",
            "description": "Object key (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "description": "Expiry, Unix seconds.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "sig",
            "in": "query",
            "description": "Hex signature.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBytes"
                }
              }
            }
          },
          "400": {
            "description": "Missing exp or sig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Bad or expired signature"
          },
          "404": {
            "description": "Unknown object"
          }
        }
      },
      "put": {
        "tags": [
          "connectors"
        ],
        "summary": "Upload through a locally presigned URL. Not behind API authentication: the\nsignature is the authorisation.",
        "operationId": "put_presigned_object",
        "parameters": [
          {
            "name": "connection",
            "in": "path",
            "description": "Object connection name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "path",
            "description": "Object key (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "description": "Expiry, Unix seconds.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "sig",
            "in": "query",
            "description": "Hex signature.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Object bytes",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/ObjectBytes"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored"
          },
          "400": {
            "description": "Missing exp or sig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Bad or expired signature"
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
