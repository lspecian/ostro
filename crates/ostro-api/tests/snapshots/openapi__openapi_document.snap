    },
    "/v1/connections": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "List connections.",
        "operationId": "list_connections",
        "responses": {
          "200": {
            "description": "Connections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/connections/{name}": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "One connection.",
        "operationId": "get_connection",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Connection name, percent-decoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "connectors"
        ],
        "summary": "Create or replace a connection.",
        "operationId": "put_connection",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Connection name, percent-decoded (http-target names are origins)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutConnectionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionDto"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or invalid config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "connectors"
        ],
        "summary": "Delete a connection.",
        "operationId": "delete_connection",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Connection name, percent-decoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Unknown connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dev/time": {
      "get": {
        "tags": [
          "dev"
        ],
        "summary": "The dev clock.",
        "description": "REST-only tooling endpoint (no gRPC). Available only with `ostro dev --ephemeral --time-skipping`; otherwise 409 with details.reason = time_skipping_disabled.",
        "operationId": "dev_time",
        "responses": {
          "200": {
            "description": "The dev clock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevTimeDto"
                }
              }
            }
          },
          "409": {
            "description": "Time skipping is off (details.reason = time_skipping_disabled)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dev/time/skip": {
      "post": {
        "tags": [
          "dev"
        ],
        "summary": "Skip the dev clock forward.",
        "description": "REST-only tooling endpoint (no gRPC). Available only with `ostro dev --ephemeral --time-skipping`; otherwise 409 with details.reason = time_skipping_disabled. Exactly one of `by` / `to_ms`; time never moves backwards.",
        "operationId": "dev_skip",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevSkipBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Skipped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevSkipDto"
                }
              }
            }
          },
          "400": {
            "description": "Neither or both of by / to_ms, or an invalid duration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Time skipping is off (details.reason = time_skipping_disabled)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dlq": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "List DLQ entries (failed and timed-out runs).",
        "operationId": "list_dlq",
        "parameters": [
          {
            "name": "workflow",
            "in": "query",
            "description": "Workflow filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "queue",
            "in": "query",
            "description": "Queue filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "description": "Failure reason prefix.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_dismissed",
            "in": "query",
            "description": "Include dismissed entries.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (default 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Continuation token.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Repeatable; every tag must match (max 8)",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of DLQ entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DlqPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter (> 8 tags: details.limit = search_tags)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dlq/{run_id}/dismiss": {
      "post": {
        "tags": [
          "operations"
        ],
        "summary": "Dismiss a DLQ entry.",
        "operationId": "dismiss_dlq",
