            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secrets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/secrets/{name}": {
      "put": {
        "tags": [
          "secrets"
        ],
        "summary": "Store a secret (create or replace). The value is write-only.",
        "operationId": "put_secret",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Secret name (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "in": "query",
            "description": "Tenant scope; absent = global secrets.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutSecretBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Secret stored (metadata only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretInfoDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name, reserved name (secret_reserved) or value shorter than 8 bytes (secret_too_short)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "secrets"
        ],
        "summary": "Delete a secret.",
        "operationId": "delete_secret",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Secret name (may contain `/`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "in": "query",
            "description": "Tenant scope; absent = global secrets.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Unknown secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/complete": {
      "post": {
        "tags": [
          "tokens"
        ],
        "summary": "Complete an await token.",
        "operationId": "complete_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteTokenBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token completed (or validated, for dry_run)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteTokenResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or unverifiable token (details.reason = token_invalid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "The token's run no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Token already completed (token_already_completed) or run terminal (run_terminal)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes, or payload exceeds limits.max_payload_bytes (details.limit = payload_bytes)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
