    "/v1/queues/{name}/failure-policy": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "A queue's failure policy (on_failure hook, DLQ policy).",
        "operationId": "get_queue_failure_policy",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The failure policy (empty when never set)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailurePolicy"
                }
              }
            }
          },
          "404": {
            "description": "Run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "operations"
        ],
        "summary": "Replace a queue's failure policy (CAS on version_tag / If-Match).",
        "operationId": "put_queue_failure_policy",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version_tag",
            "in": "query",
            "description": "Meta record version (alternatively the body's `version_tag` or `If-Match`).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FailurePolicy"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The stored policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailurePolicy"
                }
              }
            }
          },
          "400": {
            "description": "Invalid policy (hook workflow name)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Run operations not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Stale version_tag (details.reason = version_mismatch)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/queues/{name}/flow": {
      "get": {
        "tags": [
          "queues"
        ],
        "summary": "A queue's flow configuration and record version.",
        "operationId": "get_queue_flow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow configuration (version 0 = never stored)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueFlowInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid queue name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "queues"
        ],
        "summary": "Replace a queue's flow configuration (placement, selector, spill, concurrency,\nweight, throttles, rate limits, auto-pause, paused). CAS: body `expected_version`\nor `If-Match` (both given = they must agree).",
        "operationId": "put_queue_flow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Expected record version (alternative to expected_version)",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutQueueFlowBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored flow configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueFlowInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid flow (selector, period_ms, percentages, enum names)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "Stale expected_version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
