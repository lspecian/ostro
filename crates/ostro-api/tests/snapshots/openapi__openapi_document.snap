---
source: crates/ostro-api/tests/openapi.rs
expression: pretty
---
{
  "openapi": "3.1.0",
  "info": {
    "title": "Ostro API",
    "description": "Ostro control plane: modules, workflows and runs. The same operations are served over gRPC (ostro.api.v1) on the same port.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Web UI shell (placeholder until the UI phase).",
        "operationId": "ui_shell",
        "responses": {
          "200": {
            "description": "UI shell",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: always 200.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/hooks/{name}": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Deliver a webhook. The raw body is verified (signature) before anything parses it;\nthere is no other authentication. Body limit: `[triggers] webhook_body_limit`.",
        "operationId": "deliver_hook",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Webhook name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw payload, verified byte-for-byte",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HookPayload"
              }
            },
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/HookPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Delivered (the body depends on the action; a Slack url_verification challenge is echoed as text/plain)"
          },
          "202": {
            "description": "Accepted"
          },
          "401": {
            "description": "Missing or invalid signature"
          },
          "404": {
            "description": "Unknown webhook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds triggers.webhook_body_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "The OpenAPI document of this API.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: 200 iff meta has a leader and every partition is ready.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/backup": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Download an online backup (tar of the bottomless layout, P8-D7).",
        "operationId": "backup",
        "responses": {
          "200": {
            "description": "Tar stream",
            "content": {
              "application/x-tar": {
                "schema": {
                  "$ref": "#/components/schemas/BackupTar"
                }
              }
            }
          },
          "404": {
            "description": "Admin API not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Backup not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/modules/{sha256}": {
      "get": {
        "tags": [
          "modules"
        ],
        "summary": "Get a stored module.",
        "operationId": "get_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Lowercase hex sha256",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "modules"
        ],
        "summary": "Upload a Wasm module (content-addressed, idempotent).",
        "operationId": "upload_module",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "description": "Lowercase hex sha256 of the body",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Source language hint (\"rust\", \"python\", \"typescript\").",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "in": "query",
            "description": "Uploading tenant (`^[a-z0-9][a-z0-9-]{0,62}$`); absent = the default tenant.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Deployed module name (`^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`), recorded on the\nworkflow versions this upload registers.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw Wasm component bytes",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/WasmBytes"
              }
            },
            "application/wasm": {
              "schema": {
                "$ref": "#/components/schemas/WasmBytes"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Module already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadModuleResponse"
                }
              }
            }
          },
          "201": {
            "description": "Module stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadModuleResponse"
                }
              }
            }
          },
          "400": {
            "description": "sha256 mismatch or invalid module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Workflow version registered by another module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Module exceeds api.max_module_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/queues/{name}/policy": {
      "get": {
        "tags": [
          "queues"
        ],
        "summary": "A queue's run policy.",
        "operationId": "get_queue_policy",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored policy (all null when never set)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPolicyDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "queues"
        ],
        "summary": "Replace a queue's run policy (future runs only).",
        "operationId": "set_queue_policy",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Queue name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunPolicyBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPolicyDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid duration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List runs.",
        "operationId": "list_runs",
        "parameters": [
          {
            "name": "workflow",
            "in": "query",
            "description": "Workflow filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Status filter.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RunStatusDto"
            }
          },
          {
            "name": "queue",
            "in": "query",
            "description": "Queue filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Tag filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_after",
            "in": "query",
            "description": "Created at or after (RFC 3339).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Created before (RFC 3339).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (default 100, capped at 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Token from a previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or page token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get a run.",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDto"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/cancel": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Request graceful cancellation of a run (idempotent).",
        "operationId": "cancel_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Optional; an empty body means no reason, not a dry run",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopRunBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cancellation requested (already_requested on repeats)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Run already terminal (details.reason = run_terminal)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/history": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "A page of a run's history.",
        "operationId": "run_history",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from_seq",
            "in": "query",
            "description": "First seq to return (inclusive, default 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (default 100, max 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "History page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/logs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "A run's recent guest log lines (non-durable, P8-D16).",
        "operationId": "run_logs",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Most recent lines to return (default 100, max 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "level",
            "in": "query",
            "description": "Minimum level.",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Guest log level.",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent lines, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunLogsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/result": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Long-poll a run's outcome.",
        "operationId": "run_result",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "description": "Maximum wait as a friendly duration (`30s`, `500ms`); default 0 (answer now),\ncapped at 60s.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "follow_continuations",
            "in": "query",
            "description": "Follow continue-as-new successors to the last run of the chain.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current outcome; completed = false when the wait ended first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid wait duration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/retry": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Retry a terminal run: resume in place when resumable, else restart as a new run.",
        "operationId": "retry_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Optional; an empty body is not a dry run",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Run resumed or restarted (or the would-be mode, for dry_run)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Run completed successfully (details.reason = run_completed) or is not terminal (run_not_terminal)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/signals/{name}": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Send a named signal to a run.",
        "operationId": "signal_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Signal name (1..=256 bytes)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignalBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signal accepted (or validated, for dry_run)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Run already terminal (details.reason = run_terminal)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
