      }
    },
    "/v1/workflows/{name}/resume": {
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "Resume a paused workflow (idempotent).",
        "operationId": "resume_workflow",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumed (changed = false on repeats)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PauseState"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{name}/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Start a run.",
        "operationId": "start_run",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "description": "W3C traceparent (00-<trace-id>-<parent-id>-<flags>); used when the body's traceparent is empty. Invalid: 400, details.reason = invalid_traceparent",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Workflow name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Existing run returned (idempotency key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunResponse"
                }
              }
            }
          },
          "201": {
            "description": "Run created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (a tag starting with __ostro/ is reserved)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown workflow or version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key used (conflict_policy=reject); details.existing_run_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "Workflow has no active version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds api.max_request_bytes, or input exceeds limits.max_payload_bytes (details.limit = payload_bytes)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivateWorkflowBody": {
        "type": "object",
        "description": "Activation body.",
        "required": [
          "version"
        ],
        "properties": {
          "expected_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Required current record version (alternatively the `If-Match` header).",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version to activate.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Advertise": {
        "type": "object",
        "description": "The addresses a joining node advertises.",
        "required": [
          "api",
          "cluster"
        ],
        "properties": {
          "api": {
            "type": "string",
            "description": "Client API address."
          },
          "cluster": {
            "type": "string",
            "description": "Cluster listener address."
          },
          "repl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Separate replication listener, if any."
          }
        }
      },
      "BackupTar": {
        "type": "string",
        "format": "binary",
        "description": "Tar archive (documentation-only schema of the backup download)."
      },
      "BulkAction": {
        "oneOf": [
          {
            "type": "string",
            "description": "Cancel.",
            "enum": [
              "cancel"
            ]
          },
          {
            "type": "object",
            "description": "Terminate.",
            "required": [
              "terminate"
            ],
            "properties": {
              "terminate": {
                "type": "object",
                "description": "Terminate.",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Operator reason."
                  }
                }
              }
            }
          },
          {
            "type": "string",
            "description": "Retry the selected failed runs (resume in place or restart as a new linked run).",
            "enum": [
              "retry"
            ]
          },
          {
            "type": "object",
            "description": "Rerun from a cut.",
            "required": [
              "rerun"
            ],
            "properties": {
              "rerun": {
                "type": "object",
                "description": "Rerun from a cut.",
                "required": [
                  "from"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/components/schemas/RerunFrom",
                    "description": "Cut point."
                  },
                  "version": {
                    "$ref": "#/components/schemas/RerunVersion",
                    "description": "Version to execute."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "Requeue DLQ members.",
            "required": [
              "requeue"
            ],
            "properties": {
              "requeue": {
                "type": "object",
                "description": "Requeue DLQ members.",
                "properties": {
                  "mode": {
                    "$ref": "#/components/schemas/RequeueMode",
                    "description": "Mode."
                  }
                }
              }
            }
          },
          {
            "type": "string",
            "description": "Pause.",
            "enum": [
              "pause"
            ]
          },
          {
            "type": "string",
            "description": "Resume a paused run.",
            "enum": [
              "resume"
            ]
          },
          {
            "type": "object",
            "description": "Send a signal.",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "type": "object",
                "description": "Send a signal.",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Signal name."
                  },
                  "payload": {
                    "description": "Signal payload."
                  }
                }
              }
            }
          }
        ],
        "description": "The operation a bulk job applies to each matched run."
      },
      "BulkCreateRequest": {
        "type": "object",
        "description": "`POST /v1/bulk`.",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/BulkAction",
            "description": "Operation."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Count and sample only."
          },
          "filter": {
            "$ref": "#/components/schemas/BulkFilter",
            "description": "Selection."
          },
          "max_in_flight": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Concurrent ops (default `[bulk] max_in_flight`).",
            "minimum": 0
          },
          "rate_per_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Ops per second (default `[bulk] default_rate`, capped at `max_rate`).",
            "minimum": 0
          }
        }
      },
      "BulkCreateResponse": {
        "type": "object",
        "description": "Result of creating a bulk job.",
        "required": [
          "matched_estimate"
        ],
        "properties": {
          "job_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The job (`blk_<uuidv7>`); `None` on a dry run."
          },
          "matched_estimate": {
            "type": "integer",
            "format": "int64",
            "description": "Estimated matches.",
            "minimum": 0
          },
          "sample": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 20 matched run ids."
          }
        }
      },
      "BulkFailure": {
        "type": "object",
        "description": "One failed bulk op.",
        "required": [
          "run_id",
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Error."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "BulkFilter": {
        "type": "object",
        "description": "Which runs a bulk job selects.",
        "properties": {
          "created_after_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Created at or after, ms since the epoch.",
            "minimum": 0
          },
          "created_before_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Created before, ms since the epoch (the job's creation time is always added).",
            "minimum": 0
          },
          "dlq": {
            "type": "boolean",
            "description": "Only DLQ members."
          },
          "queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Queue."
          },
          "status": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunStatusDto",
                "description": "Status."
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every tag must match."
          },
          "workflow": {
            "type": [
              "string",
              "null"
            ],
            "description": "Workflow."
          }
        }
      },
      "BulkJobList": {
        "type": "object",
        "description": "`GET /v1/bulk`.",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkJobView"
            },
            "description": "Every bulk job on this node."
          }
        }
      },
      "BulkJobView": {
        "type": "object",
        "description": "A bulk job's progress.",
        "required": [
          "job_id",
          "state",
          "action",
          "matched",
          "done",
          "skipped",
          "failed_count",
          "rate_per_sec",
          "created_at_ms"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "Action name."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Created, ms since the epoch.",
            "minimum": 0
          },
          "done": {
            "type": "integer",
            "format": "int64",
            "description": "Ops applied.",
            "minimum": 0
          },
          "eta_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Estimated time to completion.",
            "minimum": 0
          },
          "failed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkFailure"
            },
            "description": "The first 100 failures."
          },
          "failed_count": {
            "type": "integer",
            "format": "int64",
            "description": "Total failures.",
            "minimum": 0
          },
          "finished_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Finished.",
            "minimum": 0
          },
          "job_id": {
            "type": "string",
            "description": "Job id."
          },
          "matched": {
            "type": "integer",
            "format": "int64",
            "description": "Runs matched.",
            "minimum": 0
          },
          "rate_per_sec": {
            "type": "integer",
            "format": "int32",
            "description": "Effective rate.",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "format": "int64",
            "description": "Runs skipped (no longer eligible).",
            "minimum": 0
          },
          "started_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Started.",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "description": "`pending` | `running` | `paused_backpressure` | `done` | `cancelled` | `failed`."
          }
        }
      },
      "CancelResponseDto": {
        "type": "object",
        "description": "Cancel result.",
        "required": [
          "already_requested",
          "dry_run"
        ],
        "properties": {
          "already_requested": {
            "type": "boolean",
            "description": "Cancellation had already been requested."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          }
        }
      },
      "CatchupPolicyDto": {
        "type": "string",
        "description": "Which missed fires are started after downtime. Numbering\n([`CatchupPolicyDto::as_u8`]) equals the meta `CATCHUP_*` constants (05-07).",
        "enum": [
          "skip",
          "one",
          "all"
        ]
      },
      "ClusterJoinRequest": {
        "type": "object",
        "description": "`POST /v1/cluster/join` (D-P13-9).",
        "required": [
          "token",
          "csr_pem",
          "advertise",
          "node_version"
        ],
        "properties": {
          "advertise": {
            "$ref": "#/components/schemas/Advertise",
            "description": "Advertised addresses."
          },
          "csr_pem": {
            "type": "string",
            "description": "PEM CSR for the node certificate."
          },
          "node_version": {
            "$ref": "#/components/schemas/NodeVersionDto",
            "description": "The joiner's binary."
          },
          "resume_node_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Resume a still-Joining id from the join marker.",
            "minimum": 0
          },
          "token": {
            "type": "string",
            "description": "Node join token (`njt_…`)."
          }
        }
      },
      "ClusterJoinResponse": {
        "type": "object",
        "description": "Answer of a join.",
        "required": [
          "node_id",
          "cluster_id",
          "partitions",
          "ca_cert_pem",
          "node_cert_pem",
          "seeds",
          "finalized_level"
        ],
        "properties": {
          "ca_cert_pem": {
            "type": "string",
            "description": "Cluster CA certificate (PEM)."
          },
          "cluster_id": {
            "type": "string",
            "description": "The cluster id."
          },
          "finalized_level": {
            "type": "integer",
            "format": "int32",
            "description": "The cluster's finalized feature level.",
            "minimum": 0
          },
          "node_cert_pem": {
            "type": "string",
            "description": "Signed node certificate (PEM)."
          },
          "node_id": {
            "type": "integer",
            "format": "int64",
            "description": "The allocated (or resumed) node id.",
            "minimum": 0
          },
          "partitions": {
            "type": "integer",
            "format": "int32",
            "description": "Partition count.",
            "minimum": 0
          },
          "seeds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeedDto"
            },
            "description": "Seeds (current members' cluster addresses)."
          }
        }
      },
      "ClusterMember": {
        "type": "object",
        "description": "One member in [`ClusterStatus`].",
        "required": [
          "node_id",
          "addr",
          "state",
          "live",
          "raft_role"
        ],
        "properties": {
          "addr": {
            "type": "string",
            "description": "Client API address."
          },
          "cluster_addr": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cluster listener address."
          },
          "live": {
            "type": "boolean",
            "description": "Live per the meta leader's liveness view."
          },
          "node_id": {
            "type": "integer",
            "format": "int64",
            "description": "Node id.",
            "minimum": 0
          },
          "raft_role": {
            "type": "string",
            "description": "Meta Raft role: `voter`, `learner`, `outgoing` or `none`."
          },
          "state": {
            "type": "string",
            "description": "`joining`, `active`, `draining` or `removed`."
          },
          "version": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NodeVersionDto",
                "description": "Reported binary, if any."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ClusterStatus": {
        "type": "object",
        "description": "`GET /v1/cluster/status`.",
        "required": [
          "cluster_id",
          "members",
          "voters",
          "learners",
          "voters_outgoing",
          "meta_leader",
          "finalized",
          "level_min",
          "level_max",
          "reassignments"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster id."
          },
          "finalized": {
            "type": "integer",
            "format": "int32",
            "description": "Finalized feature level.",
            "minimum": 0
          },
          "hold": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Operator hold.",
            "minimum": 0
          },
          "learners": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "description": "Meta learners."
          },
          "level_max": {
            "type": "integer",
            "format": "int32",
            "description": "Lowest `level_max` over members.",
            "minimum": 0
          },
          "level_min": {
            "type": "integer",
            "format": "int32",
            "description": "Lowest `level_min` over members.",
            "minimum": 0
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClusterMember"
            },
            "description": "Every member (tombstones included)."
          },
          "meta_leader": {
            "type": "integer",
            "format": "int64",
            "description": "Meta leader (0 = unknown).",
            "minimum": 0
          },
          "policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReplicationPolicyDto",
                "description": "Replication policy."
              },
              {
                "type": "null"
              }
            ]
          },
          "reassignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReassignmentDto"
            },
            "description": "In-flight reassignments."
          },
          "voters": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "description": "Meta voters."
          },
          "voters_outgoing": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "description": "Outgoing voters (non-empty while joint)."
          }
        }
      },
      "CompleteTokenBody": {
        "type": "object",
        "description": "Await-token completion body. The token travels only here, never in a URL.",
        "required": [
          "token"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only (format, MAC, op still open); nothing is submitted."
          },
          "payload": {
            "description": "Completion payload (any JSON value; defaults to null)."
          },
          "token": {
            "type": "string",
            "description": "The `ot1_...` token."
          }
        },
        "additionalProperties": false
      },
      "CompleteTokenResponseDto": {
        "type": "object",
        "description": "Await-token completion result.",
        "required": [
          "run_id",
          "accepted",
          "dry_run"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The completion was (or would be) accepted."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "run_id": {
            "type": "string",
            "description": "The run the token belongs to."
          }
        }
      },
      "ConflictPolicyDto": {
        "type": "string",
        "description": "Idempotency-key collision policy.",
        "enum": [
          "return_existing",
          "reject"
        ]
      },
      "ConnectionDto": {
        "type": "object",
        "description": "A connection.",
        "required": [
          "name",
          "kind",
          "config"
        ],
        "properties": {
          "config": {
            "description": "Kind-specific config."
          },
          "kind": {
            "type": "string",
            "description": "Connection kind."
          },
          "name": {
            "type": "string",
            "description": "Connection name."
          }
        }
      },
      "ConnectionListResponse": {
        "type": "object",
        "description": "`GET /v1/connections` response.",
        "required": [
          "connections"
        ],
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionDto"
            },
            "description": "Connections sorted by name."
          }
        }
      },
      "CreateWorkerTokenRequest": {
        "type": "object",
        "description": "`POST /v1/workers/tokens` body (optional).",
        "properties": {
          "ttl_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Token lifetime in ms (> 0); absent = `[workers] join_token_ttl`.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "DeletedDto": {
        "type": "object",
        "description": "Delete result.",
        "required": [
          "name",
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Always true on success."
          },
          "name": {
            "type": "string",
            "description": "Deleted record name."
          }
        }
      },
      "DemandSnapshot": {
        "type": "object",
        "description": "Worker demand of a queue (D-W12): `demand = running_on_workers + admissible\nbacklog for workers` (`embedded` queues: 0; `auto`: the backlog only while\nspilling). The KEDA scaling signal.",
        "required": [
          "queue",
          "demand",
          "backlog",
          "running_on_workers",
          "placement",
          "spilling",
          "workers",
          "worker_slots_free"
        ],
        "properties": {
          "backlog": {
            "type": "integer",
            "format": "int64",
            "description": "Admissible ready entries waiting for a worker.",
            "minimum": 0
          },
          "demand": {
            "type": "integer",
            "format": "int64",
            "description": "Worker slots the queue could use now.",
            "minimum": 0
          },
          "placement": {
            "$ref": "#/components/schemas/Placement",
            "description": "Effective placement."
          },
          "queue": {
            "type": "string",
            "description": "Queue name."
          },
          "running_on_workers": {
            "type": "integer",
            "format": "int64",
            "description": "Activations of the queue running on workers.",
            "minimum": 0
          },
          "spilling": {
            "type": "boolean",
            "description": "`auto` placement is currently spilling to workers."
          },
          "worker_slots_free": {
            "type": "integer",
            "format": "int64",
            "description": "Free worker slots (all workers).",
            "minimum": 0
          },
          "workers": {
            "type": "integer",
            "format": "int64",
            "description": "Connected workers.",
            "minimum": 0
          }
        }
      },
      "DevSkipBody": {
        "type": "object",
        "description": "`POST /v1/dev/time/skip` body: exactly one of `by` (friendly duration, e.g. `\"72h\"`;\nwrite days as hours) or `to_ms` (absolute target, ms since the epoch; a target in\nthe past skips nothing).",
        "properties": {
          "by": {
            "type": [
              "string",
              "null"
            ],
            "description": "Relative skip (`\"30s\"`, `\"72h\"`)."
          },
          "to_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Absolute target, ms since the Unix epoch.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "DevSkipDto": {
        "type": "object",
        "description": "`POST /v1/dev/time/skip` response.",
        "required": [
          "now_ms",
          "offset_ms",
          "skipped_ms"
        ],
        "properties": {
          "now_ms": {
            "type": "integer",
            "format": "int64",
            "description": "The server's time after the skip, ms since the Unix epoch.",
            "minimum": 0
          },
          "offset_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Total skipped so far, ms.",
            "minimum": 0
          },
          "skipped_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Milliseconds this skip advanced (0 for a target in the past).",
            "minimum": 0
          }
        }
      },
      "DevTimeDto": {
        "type": "object",
        "description": "`GET /v1/dev/time` response.",
        "required": [
          "now_ms",
          "offset_ms",
          "mode",
          "idle"
        ],
        "properties": {
          "idle": {
            "type": "boolean",
            "description": "The node has no ready, granting or executing work."
          },
          "mode": {
            "$ref": "#/components/schemas/DevTimeModeDto",
            "description": "Time-skipping mode."
          },
          "next_due_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Earliest due timer or delayed start, ms since the epoch; null when none.",
            "minimum": 0
          },
          "now_ms": {
            "type": "integer",
            "format": "int64",
            "description": "The server's current (skipped) time, ms since the Unix epoch.",
            "minimum": 0
          },
          "offset_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Total skipped so far, ms (only grows).",
            "minimum": 0
          }
        }
      },
      "DevTimeModeDto": {
        "type": "string",
        "description": "Time-skipping mode.",
        "enum": [
          "off",
          "auto",
          "manual"
        ]
      },
      "DismissBody": {
