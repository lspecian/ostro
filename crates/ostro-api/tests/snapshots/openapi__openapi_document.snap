    },
    "/v1/cluster/upgrade/finalize": {
      "post": {
        "tags": [
          "cluster"
        ],
        "summary": "Finalize the highest common feature level.",
        "operationId": "upgrade_finalize",
        "responses": {
          "200": {
            "description": "Upgrade status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpgradeStatus"
                }
              }
