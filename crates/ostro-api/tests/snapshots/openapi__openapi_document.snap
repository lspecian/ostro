          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant."
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C traceparent."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow."
          }
        }
      },
      "RunListResponse": {
