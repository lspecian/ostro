    "/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List runs.",
        "operationId": "list_runs",
        "parameters": [
          {
            "name": "workflow",
            "in": "query",
            "description": "Workflow filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Status filter.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RunStatusDto"
            }
          },
          {
            "name": "queue",
            "in": "query",
            "description": "Queue filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Tag filter (same as one `tags` value).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Result order: `oldest` (default) or `newest` (D-P11-10).",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ListOrderDto"
            }
          },
          {
            "name": "dlq",
            "in": "query",
            "description": "Only DLQ members (failed / timed-out runs not dismissed or requeued).",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "created_after",
            "in": "query",
            "description": "Created at or after (RFC 3339).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Created before (RFC 3339).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (default 100, capped at 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Token from a previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Repeatable; every tag must match (AND, max 8; tag counts as one)",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or page token; > 8 tags: details.limit = search_tags",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/migrate": {
      "post": {
        "tags": [
          "runs"
