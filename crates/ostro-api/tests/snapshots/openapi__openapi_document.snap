          "workflow": {
            "type": "string",
            "description": "Workflow to start."
          }
        },
        "additionalProperties": false
      },
      "ScheduleListResponse": {
        "type": "object",
        "description": "Schedule listing.",
        "required": [
          "schedules"
        ],
        "properties": {
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleDto"
            },
            "description": "Every schedule, by name."
          }
        }
      },
      "SecretInfoDto": {
        "type": "object",
        "description": "Metadata of a stored secret (never its value).",
        "required": [
          "name",
          "key_id"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "description": "Id of the sealing key the value is sealed under."
          },
          "name": {
            "type": "string",
            "description": "Secret name."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant scope; null = global."
          }
        }
      },
      "SecretListResponse": {
        "type": "object",
        "description": "`GET /v1/secrets` response.",
        "required": [
          "secrets"
        ],
        "properties": {
          "secrets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecretInfoDto"
            },
            "description": "Secrets sorted by name."
          }
        }
      },
      "SignalBody": {
        "type": "object",
        "description": "Signal body.",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; nothing is submitted."
          },
          "payload": {
            "description": "Signal payload (any JSON value; defaults to null)."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional dedupe id (<= 64 bytes): a repeat is acknowledged with\n`duplicate: true` and not delivered again."
          }
        },
        "additionalProperties": false
      },
      "SignalResponseDto": {
        "type": "object",
        "description": "Signal result.",
        "required": [
          "accepted",
          "duplicate",
          "dry_run"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The signal was (or would be) accepted."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "duplicate": {
            "type": "boolean",
            "description": "`request_id` was already seen for this run."
          }
        }
      },
      "SpillPolicyDto": {
        "type": "object",
        "description": "Auto-placement spill thresholds. Percentages are 0..=100.",
        "required": [
          "cpu_pct",
          "slots_pct",
          "mem_pct",
          "lag_ms",
          "sustain_ms",
          "cooldown_ms",
          "hysteresis_pct"
        ],
        "properties": {
          "cooldown_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Minimum dwell before spilling stops, in ms.",
            "minimum": 0
          },
          "cpu_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Process CPU %.",
            "minimum": 0
          },
          "hysteresis_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Exit threshold as a % of the entry threshold.",
            "minimum": 0
          },
          "lag_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Oldest-ready queue lag in ms.",
            "minimum": 0
          },
          "mem_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Wasm memory %.",
            "minimum": 0
          },
          "slots_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Embedded slot utilisation %.",
            "minimum": 0
          },
          "sustain_ms": {
            "type": "integer",
            "format": "int64",
            "description": "How long a signal must stay above its threshold, in ms.",
            "minimum": 0
          }
        }
      },
      "StartRunBody": {
        "type": "object",
        "description": "Start-run body.",
        "properties": {
          "concurrency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Concurrency key."
          },
          "conflict_policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ConflictPolicyDto",
                "description": "Collision policy (default `return_existing`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "delay_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Delay before the run becomes ready, ms.",
            "minimum": 0
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate only: the same checks as a real start, nothing is submitted. The response\nreports the would-be outcome (`run_id` = the existing run for a reused idempotency\nkey, else empty)."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Idempotency key."
          },
          "input": {
            "description": "Workflow input (any JSON value; defaults to null)."
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Priority."
          },
          "queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Queue override."
          },
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention override for the terminal run (friendly duration in hours or smaller\nunits, e.g. `\"168h\"`; `7d` is rejected). Unset: workflow policy, queue policy, then\nthe server's `[runs] retention`."
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout override (friendly duration, e.g. `\"30s\"`; `\"0s\"` = none).\nUnset: the workflow policy, then the queue policy."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant."
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C traceparent."
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Explicit version (else the active one).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "StartRunResponse": {
        "type": "object",
        "description": "Start-run result.",
        "required": [
          "run_id",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "`false` when an existing run was returned."
          },
          "dry_run": {
            "type": "boolean",
            "description": "`true` for a dry run (omitted otherwise). A dry run returns the existing run's id\nfor a reused idempotency key, else an empty `run_id`."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "StopRunBody": {
        "type": "object",
        "description": "Cancel / terminate body (the whole body is optional).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; nothing is submitted."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason (<= 1024 bytes), recorded in history."
          }
        },
        "additionalProperties": false
      },
      "TerminateResponseDto": {
        "type": "object",
        "description": "Terminate result.",
        "required": [
          "status",
          "dry_run"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status afterwards (`terminated`)."
          }
        }
      },
      "TriggerScheduleBody": {
        "type": "object",
        "description": "Manual trigger body (optional).",
        "properties": {
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Idempotency of the manual fire (1..=64 bytes): a repeat returns the same run."
          }
        },
        "additionalProperties": false
      },
      "TriggerScheduleResponseDto": {
        "type": "object",
        "description": "Manual trigger result.",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "description": "The started (or deduplicated) run."
          }
        }
      },
      "UploadModuleResponse": {
        "type": "object",
        "description": "Upload result.",
        "required": [
          "module",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "`false` on idempotent re-upload."
          },
          "module": {
            "$ref": "#/components/schemas/ModuleDto",
            "description": "The stored module."
          }
        }
      },
      "VerifierDto": {
        "type": "object",
        "description": "Signature verifier. The secret is never returned: `secret_ref` names a sealed\nsecret.",
        "properties": {
          "algorithm": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: `sha256` (default) or `legacy_sha1`."
          },
          "encoding": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: `hex` or `base64`."
          },
          "header": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signature header."
          },
          "kind": {
            "$ref": "#/components/schemas/VerifierKindDto",
            "description": "Kind."
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signature prefix (e.g. `sha256=`)."
          },
          "secret_ref": {
            "type": "string",
            "description": "Sealed secret name (required unless kind = none)."
          },
          "template": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signed template (`{body}` or `{ts}.{body}`)."
          },
          "timestamp_header": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: timestamp header."
          },
          "tolerance_s": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Replay window, seconds (unset = the verifier default).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "VerifierKindDto": {
        "type": "string",
        "description": "Signature verifier kind.",
        "enum": [
          "none",
          "stripe",
          "github",
          "slack",
          "standard",
          "hmac"
        ]
      },
      "WasmBytes": {
        "type": "string",
        "format": "binary",
        "description": "Raw Wasm component bytes (documentation-only schema of the upload body)."
      },
      "WebhookActionDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "Start a run (idempotency key = the delivery key, conflict policy return-existing).",
            "required": [
              "workflow",
              "kind"
            ],
            "properties": {
              "input": {
                "type": "string",
                "description": "`\"body\"` (the whole body) or a JSON pointer into it."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "start"
                ]
              },
              "version": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int32",
                "description": "Version (unset = active).",
                "minimum": 0
              },
              "workflow": {
                "type": "string",
                "description": "Workflow."
              }
            }
          },
          {
            "type": "object",
            "description": "Signal a run (request id = the delivery key).",
            "required": [
              "workflow",
              "run_by",
              "name",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "signal"
                ]
              },
              "name": {
                "type": "string",
                "description": "Signal name."
              },
              "run_by": {
                "$ref": "#/components/schemas/RunByDto",
                "description": "How the run is found."
              },
              "workflow": {
                "type": "string",
                "description": "Workflow of the target run."
              }
            }
          },
          {
            "type": "object",
            "description": "Complete an await token.",
            "required": [
              "token_pointer",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "complete_token"
                ]
              },
              "token_pointer": {
                "type": "string",
                "description": "JSON pointer to the token in the body."
              }
            }
          }
        ],
        "description": "What a verified delivery does."
      },
      "WebhookDto": {
        "type": "object",
        "description": "An inbound webhook (meta `Webhook`).",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/WebhookActionDto",
            "description": "Action."
          },
          "idempotency": {
            "type": [
              "string",
              "null"
            ],
            "description": "`header:<name>`, `json:<pointer>` or `none` (unset = the verifier's default)."
          },
          "name": {
            "type": "string",
            "description": "Webhook name (`[A-Za-z0-9_.-]{1,128}`), the `{name}` of `POST /hooks/{name}`."
          },
          "verifier": {
            "$ref": "#/components/schemas/VerifierDto",
            "description": "Verifier."
          },
          "version_tag": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Meta record version (CAS input on PUT).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "WebhookListResponse": {
        "type": "object",
        "description": "Webhook listing.",
        "required": [
          "webhooks"
        ],
        "properties": {
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDto"
            },
            "description": "Every webhook, by name."
          }
        }
      },
      "WorkerInfo": {
        "type": "object",
        "description": "A connected worker.",
        "required": [
          "worker_id",
          "labels",
          "slots",
          "free_slots",
          "leases",
          "connected_at_ms",
          "node_id",
          "draining"
        ],
        "properties": {
          "connected_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "When the session opened (Unix ms).",
            "minimum": 0
          },
          "draining": {
            "type": "boolean",
            "description": "Draining: no new work is assigned."
          },
          "free_slots": {
            "type": "integer",
            "format": "int32",
            "description": "Slots not holding a lease.",
            "minimum": 0
          },
          "labels": {
            "type": "object",
            "description": "Worker labels (matched by queue selectors).",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "leases": {
            "type": "integer",
            "format": "int32",
            "description": "Leases held.",
            "minimum": 0
          },
          "node_id": {
            "type": "integer",
            "format": "int64",
            "description": "Server node holding the session.",
            "minimum": 0
          },
          "slots": {
            "type": "integer",
            "format": "int32",
            "description": "Advertised slots.",
            "minimum": 0
          },
          "worker_id": {
            "type": "string",
            "description": "Worker id (from its certificate)."
          }
        }
      },
      "WorkerList": {
        "type": "object",
        "description": "`GET /v1/workers` response.",
        "required": [
          "workers"
        ],
        "properties": {
          "workers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerInfo"
            },
            "description": "Workers, sorted by id."
          }
        }
      },
      "WorkerTokenCreated": {
        "type": "object",
        "description": "A freshly created join token. `token` is shown here once and never again;\n`Debug` redacts it (and the join command that embeds it).",
        "required": [
          "token_id",
          "token",
          "join_command",
          "expires_at_ms"
        ],
        "properties": {
          "expires_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Expiry (Unix ms).",
            "minimum": 0
          },
          "join_command": {
            "type": "string",
            "description": "A ready-to-run `ostro worker --join .. --token .. --ca-hash ..` line."
          },
          "token": {
            "type": "string",
            "description": "`wkr_<id>.<secret>`; only in this response."
          },
          "token_id": {
            "type": "string",
            "description": "Token id (`wkr_<id>`)."
          }
        }
      },
      "WorkerTokenInfo": {
        "type": "object",
        "description": "A join token without its secret.",
        "required": [
          "token_id",
          "created_at_ms"
        ],
        "properties": {
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time (Unix ms).",
            "minimum": 0
          },
          "expires_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Expiry (Unix ms), when set.",
            "minimum": 0
          },
          "token_id": {
            "type": "string",
            "description": "Token id (`wkr_<id>`)."
          }
        }
      },
      "WorkerTokenList": {
        "type": "object",
        "description": "`GET /v1/workers/tokens` response.",
        "required": [
          "tokens"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerTokenInfo"
            },
            "description": "Tokens, sorted by id."
          }
        }
      },
      "WorkflowDto": {
        "type": "object",
        "description": "A workflow.",
        "required": [
          "name",
          "versions",
          "record_version"
        ],
        "properties": {
          "active_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Active version.",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "record_version": {
            "type": "integer",
            "format": "int64",
            "description": "Record version (CAS token for activation; also accepted via `If-Match`).",
            "minimum": 0
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowVersionDto"
            },
            "description": "Versions, ascending."
          }
        }
      },
      "WorkflowRefDto": {
        "type": "object",
        "description": "Workflow name + version.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Workflow name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Workflow version.",
            "minimum": 0
          }
        }
      },
      "WorkflowVersionDto": {
        "type": "object",
        "description": "One workflow version.",
        "required": [
          "version",
          "module_sha256"
        ],
        "properties": {
          "default_queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default queue."
          },
          "module_sha256": {
            "type": "string",
            "description": "Implementing module."
          },
          "run_timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Default run timeout in ms.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "modules",
      "description": "Wasm module storage"
    },
    {
      "name": "workflows",
      "description": "Workflow versions and activation"
    },
    {
      "name": "runs",
      "description": "Starting and inspecting runs"
    },
    {
      "name": "tokens",
      "description": "Await-token completion"
    },
    {
      "name": "queues",
      "description": "Queue run policies"
    },
    {
      "name": "schedules",
      "description": "Cron schedules (Phase 8)"
    },
    {
      "name": "webhooks",
      "description": "Inbound webhooks: definitions and POST /hooks/{name} (Phase 8)"
    },
    {
      "name": "admin",
      "description": "Online backup (Phase 8)"
    },
    {
      "name": "secrets",
      "description": "Write-only secrets and origin-bound secret grants (Phase 6)"
    },
    {
      "name": "connectors",
      "description": "Connections, module egress policies and presigned object URLs (Phase 6)"
    },
    {
      "name": "workers",
      "description": "Worker administration, join tokens and join (Phase 7)"
    },
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "meta",
      "description": "API document and UI shell"
    }
  ]
}
