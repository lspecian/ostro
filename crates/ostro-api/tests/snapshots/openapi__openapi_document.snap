                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/modules": {
      "get": {
        "tags": [
          "inventory"
        ],
        "summary": "Stored modules.",
        "operationId": "list_modules",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (default 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Continuation token.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
