          },
          "min_insync": {
            "type": "integer",
            "format": "int32",
            "description": "Target min_insync.",
            "minimum": 0
          },
          "rf": {
            "type": "integer",
            "format": "int32",
            "description": "Target replication factor.",
            "minimum": 0
          }
        }
      },
      "RequeueBody": {
        "type": "object",
        "description": "Body of `POST /v1/dlq/{run_id}/requeue` (optional: empty = auto, not a dry run).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only."
          },
          "mode": {
            "$ref": "#/components/schemas/RequeueMode",
            "description": "Mode."
          }
        }
      },
      "RequeueMode": {
        "oneOf": [
          {
            "type": "string",
            "description": "Resume if resumable, else restart.",
            "enum": [
              "auto"
            ]
          },
          {
            "type": "string",
            "description": "Resume the run in place.",
            "enum": [
              "resume"
            ]
          },
          {
            "type": "string",
            "description": "Start a new run with the same input.",
            "enum": [
              "restart"
            ]
          },
          {
            "type": "object",
            "description": "Rerun from a cut.",
            "required": [
              "rerun"
            ],
            "properties": {
              "rerun": {
                "type": "object",
                "description": "Rerun from a cut.",
                "required": [
                  "from"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/components/schemas/RerunFrom",
                    "description": "Cut point."
                  }
                }
              }
            }
          }
        ],
        "description": "How a DLQ entry is requeued."
      },
      "RerunBody": {
        "type": "object",
        "description": "Body of `POST /v1/runs/{run_id}/rerun`.",
        "required": [
          "from"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only."
          },
          "from": {
            "$ref": "#/components/schemas/RerunFrom",
            "description": "Cut point."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dedupe key of the new run."
          },
          "version": {
            "$ref": "#/components/schemas/RerunVersion",
            "description": "Version to execute (default `active`)."
          }
        }
      },
      "RerunCut": {
        "type": "object",
        "description": "One candidate cut of a run (for the UI).",
        "required": [
          "seq",
          "occurrence",
          "safe"
        ],
        "properties": {
          "nearest_safe_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Nearest safe cut, when unsafe.",
            "minimum": 0
          },
          "occurrence": {
            "type": "integer",
            "format": "int32",
            "description": "1-based occurrence of `step`.",
            "minimum": 0
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why not, when unsafe."
          },
          "safe": {
            "type": "boolean",
            "description": "Whether a rerun may cut here."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Journal sequence number.",
            "minimum": 0
          },
          "step": {
            "type": [
              "string",
              "null"
            ],
            "description": "Step name at this point, if any."
          }
        }
      },
      "RerunCutsView": {
        "type": "object",
        "description": "`GET /v1/runs/{id}/rerun-cuts`.",
        "required": [
          "run_id",
          "cuts"
        ],
        "properties": {
          "cuts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RerunCut"
            },
            "description": "Candidate cuts in journal order."
          },
          "run_id": {
            "type": "string",
            "description": "The analysed run."
          }
        }
      },
      "RerunFrom": {
        "oneOf": [
          {
            "type": "object",
            "description": "Journal sequence number: events `< seq` are copied.",
            "required": [
              "seq"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "format": "int64",
                "description": "Journal sequence number: events `< seq` are copied.",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "description": "The `occurrence`-th (1-based) execution of step `name`.",
            "required": [
              "step"
            ],
            "properties": {
              "step": {
                "type": "object",
                "description": "The `occurrence`-th (1-based) execution of step `name`.",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Step name."
                  },
                  "occurrence": {
                    "type": "integer",
                    "format": "int32",
                    "description": "1-based occurrence (default 1).",
                    "minimum": 0
                  }
                }
              }
            }
          }
        ],
        "description": "Where a rerun cuts the source journal."
      },
      "RerunResponse": {
        "type": "object",
        "description": "Result of a rerun.",
        "required": [
          "source_run_id",
          "cut_seq",
          "copied_events",
          "workflow",
          "version",
          "verdict"
        ],
        "properties": {
          "copied_events": {
            "type": "integer",
            "format": "int64",
            "description": "Events copied from the source.",
            "minimum": 0
          },
          "cut_seq": {
            "type": "integer",
            "format": "int64",
            "description": "Effective cut sequence number.",
            "minimum": 0
          },
          "existing": {
            "type": "boolean",
            "description": "`true` when the idempotency key returned an existing run."
          },
          "new_run_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The new run; `None` on a dry run."
          },
          "source_run_id": {
            "type": "string",
            "description": "Source run."
          },
          "verdict": {
            "type": "string",
            "description": "`\"ok\"` or `\"ok_frontier\"`."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version of the new run.",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow of the new run."
          }
        }
      },
      "RerunVersion": {
        "oneOf": [
          {
            "type": "string",
            "description": "The workflow's active version.",
            "enum": [
              "active"
            ]
          },
          {
            "type": "string",
            "description": "The source run's version.",
            "enum": [
              "source"
            ]
          },
          {
            "type": "object",
            "description": "An explicit version.",
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "format": "int32",
                "description": "An explicit version.",
                "minimum": 0
              }
            }
          }
        ],
        "description": "Which workflow version a rerun executes."
      },
      "RetireModuleResponse": {
        "type": "object",
        "description": "`DELETE /v1/modules/{sha}`.",
        "required": [
          "sha256",
          "retired_at_ms",
          "versions"
        ],
        "properties": {
          "retired_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Retirement time (Unix ms).",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "description": "Module sha256 (hex)."
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowVersionRef"
            },
            "description": "Workflow versions retired with it."
          }
        }
      },
      "RetryBody": {
        "type": "object",
        "description": "Retry body (the whole body is optional).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; reports the mode the retry would use."
          }
        },
        "additionalProperties": false
      },
      "RetryModeDto": {
        "type": "string",
        "description": "How a retry was carried out.",
        "enum": [
          "resumed",
          "restarted"
        ]
      },
      "RetryResponseDto": {
        "type": "object",
        "description": "Retry result.",
        "required": [
          "mode",
          "run_id",
          "dry_run"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "mode": {
            "$ref": "#/components/schemas/RetryModeDto",
            "description": "Resume or restart."
          },
          "run_id": {
            "type": "string",
            "description": "The resumed run, or the new run (`restarted`; the original id for dry_run)."
          }
        }
      },
      "RunByDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "JSON pointer to the run id in the body.",
            "required": [
              "run_id_pointer"
            ],
            "properties": {
              "run_id_pointer": {
                "type": "string",
                "description": "JSON pointer to the run id in the body."
              }
            }
          },
          {
            "type": "object",
            "description": "JSON pointer to the start idempotency key in the body.",
            "required": [
              "idempotency_pointer"
            ],
            "properties": {
              "idempotency_pointer": {
                "type": "string",
                "description": "JSON pointer to the start idempotency key in the body."
              }
            }
          }
        ],
        "description": "How a signal webhook finds its run."
      },
      "RunDto": {
        "type": "object",
        "description": "Full run view.",
        "required": [
          "run_id",
          "workflow",
          "version",
          "module_sha256",
          "queue",
          "status",
          "tags",
          "priority",
          "created_at",
          "created_at_ms"
        ],
        "properties": {
          "attempt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Current attempt.",
            "minimum": 0
          },
          "attempt_failures": {
            "type": "integer",
            "format": "int32",
            "description": "Durable count of retryable attempt failures: the meaningful retry count\n(`attempt` counts dispatches, including resumes).",
            "minimum": 0
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Completion time (RFC 3339)."
          },
          "completed_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Completion time, ms since the Unix epoch.",
            "minimum": 0
          },
          "concurrency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Concurrency key."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (RFC 3339)."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time, ms since the Unix epoch.",
            "minimum": 0
          },
          "failure": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failure message."
          },
          "module_sha256": {
            "type": "string",
            "description": "Implementing module."
          },
          "pause": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunPauseMark",
                "description": "Pause mark while the run is paused (reason, detail, time); absent = not paused."
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Priority."
          },
          "published_status": {
            "description": "Latest published status (embedded JSON)."
          },
          "queue": {
            "type": "string",
            "description": "Queue."
          },
          "result": {
            "description": "Result of a completed run (embedded JSON)."
          },
          "retention_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Resolved retention of the terminal run, ms (absent = keep forever).",
            "minimum": 0
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          },
          "schedule_to_start_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Resolved schedule-to-start timeout, ms (absent = none).",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant."
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C traceparent."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow."
          }
        }
      },
      "RunListResponse": {
        "type": "object",
        "description": "A page of runs.",
        "required": [
          "runs"
        ],
        "properties": {
          "next_page_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Token for the next page, if any."
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunSummaryDto"
            },
            "description": "Runs."
          }
        }
      },
      "RunLogLine": {
        "type": "object",
        "description": "One guest log line.",
        "required": [
          "ts_ms",
          "level",
          "message",
          "fields",
          "attempt"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32",
            "description": "Attempt that emitted the line.",
            "minimum": 0
          },
          "fields": {
            "description": "Structured fields (a JSON object)."
          },
          "level": {
            "$ref": "#/components/schemas/LogLevelDto",
            "description": "Level."
          },
          "message": {
            "type": "string",
            "description": "Message."
          },
          "ts_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Emission time, ms since the Unix epoch.",
            "minimum": 0
          }
        }
      },
      "RunLogsResponse": {
        "type": "object",
        "description": "A run's recent guest log lines (non-durable ring buffer, P8-D16).",
        "required": [
          "run_id",
          "lines",
          "dropped"
        ],
        "properties": {
          "dropped": {
            "type": "integer",
            "format": "int64",
            "description": "Lines dropped for this run by rate limits, caps or ring eviction (best effort).",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunLogLine"
            },
            "description": "Lines, oldest first."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "RunPauseMark": {
        "type": "object",
        "description": "The pause mark of a paused run, shown on `GET /v1/runs/{id}` (07-22, OPS-01).",
        "required": [
          "reason",
          "detail",
          "at_ms"
        ],
        "properties": {
          "at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "When the pause took effect, ms since the Unix epoch.",
            "minimum": 0
          },
          "detail": {
            "type": "string",
            "description": "Operator note or auto-pause detail (may be empty)."
          },
          "reason": {
            "type": "string",
            "description": "Why the run is paused: `operator` (pause API/CLI) or `retries_exhausted`\n(auto-pause, `on_retries_exhausted = \"pause\"`); `reason_<n>` for an unknown code."
          }
        }
      },
      "RunPauseState": {
        "type": "object",
        "description": "Pause state of a run after a pause/resume call.",
        "required": [
          "run_id",
          "paused",
          "changed"
        ],
        "properties": {
          "changed": {
            "type": "boolean",
            "description": "False when the run already was in the requested state."
          },
          "paused": {
            "type": "boolean",
            "description": "Paused after the call."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "RunPolicyBody": {
        "type": "object",
        "description": "Run policy body: friendly durations (`168h`, `30s`; write days as hours).\nOmitted fields are cleared (PUT replaces the whole policy).",
        "properties": {
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention of terminal runs and their journals."
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout for the initial start."
          }
        },
        "additionalProperties": false
      },
      "RunPolicyDto": {
        "type": "object",
        "description": "A stored run policy (unset = no override at this level).",
        "properties": {
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention as a friendly duration."
          },
          "retention_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Retention in ms.",
            "minimum": 0
          },
          "schedule_to_start_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Schedule-to-start timeout in ms.",
            "minimum": 0
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout as a friendly duration."
          }
        }
      },
      "RunResultDto": {
        "type": "object",
        "description": "Long-poll result (200 whether or not the run is terminal).",
        "required": [
          "run_id",
          "status",
          "completed"
        ],
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "True when `status` is terminal."
          },
          "failure": {
            "description": "Failure of a failed run (absent otherwise)."
          },
          "result": {
            "description": "Result of a completed run (absent otherwise)."
          },
          "run_id": {
            "type": "string",
            "description": "The run answered for (the last successor when following continuations)."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Current status."
          }
        }
      },
      "RunStatusDto": {
        "type": "string",
        "description": "Run status. `scheduled` covers both a run waiting for its start delay and a run\nsuspended on a wait (timer, signal, child run or in-flight effect); there is no\nseparate suspended status.",
        "enum": [
          "scheduled",
          "ready",
          "running",
          "completed",
          "failed",
          "cancelled",
          "terminated",
          "timed_out",
          "continued_as_new"
        ]
      },
      "RunSummaryDto": {
        "type": "object",
        "description": "Run listing row.",
        "required": [
          "run_id",
          "workflow",
          "version",
          "status",
          "queue",
          "created_at",
          "created_at_ms",
          "tags"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (RFC 3339)."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time, ms since the Unix epoch.",
            "minimum": 0
          },
          "queue": {
            "type": "string",
            "description": "Queue."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow."
          }
        }
      },
      "ScheduleDto": {
        "type": "object",
        "description": "A cron schedule (meta `Schedule`). On PUT the name comes from the path (a body name\nmust match it); `version_tag` is the CAS input on PUT and the stored record version\non output; `next_fire_at_ms` / `last_fire_at_ms` are output only.",
        "properties": {
          "catchup": {
            "$ref": "#/components/schemas/CatchupPolicyDto",
            "description": "Catch-up policy."
          },
          "catchup_window_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "How far back missed fires are considered, ms (unset or 0 = server default).",
            "minimum": 0
          },
          "cron": {
            "type": "string",
            "description": "Cron expression."
          },
          "end_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "No fire after this time (ms since the Unix epoch).",
            "minimum": 0
          },
          "input": {
            "description": "Run input (any JSON value; defaults to null)."
          },
          "last_fire_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Last fire time (output only).",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Schedule name (`[A-Za-z0-9_.-]{1,128}`)."
          },
          "next_fire_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Next fire time, computed by the server (output only).",
            "minimum": 0
          },
          "overlap": {
            "$ref": "#/components/schemas/OverlapPolicyDto",
            "description": "Overlap policy."
          },
          "paused": {
            "type": "boolean",
            "description": "Paused schedules do not fire."
          },
          "start_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "No fire before this time (ms since the Unix epoch).",
            "minimum": 0
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone; empty = UTC."
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Workflow version (unset = the active version at fire time).",
            "minimum": 0
          },
          "version_tag": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Meta record version (CAS input on PUT).",
            "minimum": 0
          },
          "workflow": {
            "type": "string",
            "description": "Workflow to start."
          }
        },
        "additionalProperties": false
      },
      "ScheduleListResponse": {
        "type": "object",
        "description": "Schedule listing.",
        "required": [
          "schedules"
        ],
        "properties": {
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleDto"
            },
            "description": "Every schedule, by name."
          }
        }
      },
      "SecretInfoDto": {
        "type": "object",
        "description": "Metadata of a stored secret (never its value).",
        "required": [
          "name",
          "key_id"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "description": "Id of the sealing key the value is sealed under."
          },
          "name": {
            "type": "string",
            "description": "Secret name."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant scope; null = global."
          }
        }
      },
      "SecretListResponse": {
        "type": "object",
        "description": "`GET /v1/secrets` response.",
        "required": [
          "secrets"
        ],
        "properties": {
          "secrets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecretInfoDto"
            },
            "description": "Secrets sorted by name."
          }
        }
      },
      "SeedDto": {
        "type": "object",
        "description": "One seed in a [`JoinResponse`] (written to `<data>/cluster-seeds.toml`).",
        "required": [
          "id",
          "addr"
        ],
        "properties": {
          "addr": {
            "type": "string",
            "description": "Cluster listener address."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Node id.",
            "minimum": 0
          },
          "repl_addr": {
            "type": [
              "string",
              "null"
            ],
            "description": "Separate replication listener, if any."
          }
        }
      },
      "SignalBody": {
        "type": "object",
        "description": "Signal body.",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; nothing is submitted."
          },
          "payload": {
            "description": "Signal payload (any JSON value; defaults to null)."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional dedupe id (<= 64 bytes): a repeat is acknowledged with\n`duplicate: true` and not delivered again."
          }
        },
        "additionalProperties": false
      },
      "SignalResponseDto": {
        "type": "object",
        "description": "Signal result.",
        "required": [
          "accepted",
          "duplicate",
          "dry_run"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The signal was (or would be) accepted."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "duplicate": {
            "type": "boolean",
            "description": "`request_id` was already seen for this run."
          }
        }
      },
      "SpillPolicyDto": {
        "type": "object",
        "description": "Auto-placement spill thresholds. Percentages are 0..=100.",
        "required": [
          "cpu_pct",
          "slots_pct",
          "mem_pct",
          "lag_ms",
          "sustain_ms",
          "cooldown_ms",
          "hysteresis_pct"
        ],
        "properties": {
          "cooldown_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Minimum dwell before spilling stops, in ms.",
            "minimum": 0
          },
          "cpu_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Process CPU %.",
            "minimum": 0
          },
          "hysteresis_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Exit threshold as a % of the entry threshold.",
            "minimum": 0
          },
          "lag_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Oldest-ready queue lag in ms.",
            "minimum": 0
          },
          "mem_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Wasm memory %.",
            "minimum": 0
          },
          "slots_pct": {
            "type": "integer",
            "format": "int32",
            "description": "Embedded slot utilisation %.",
            "minimum": 0
          },
          "sustain_ms": {
            "type": "integer",
            "format": "int64",
            "description": "How long a signal must stay above its threshold, in ms.",
            "minimum": 0
          }
        }
      },
      "StartRunBody": {
        "type": "object",
        "description": "Start-run body.",
        "properties": {
          "concurrency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Concurrency key."
          },
          "conflict_policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ConflictPolicyDto",
                "description": "Collision policy (default `return_existing`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "delay_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Delay before the run becomes ready, ms.",
            "minimum": 0
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate only: the same checks as a real start, nothing is submitted. The response\nreports the would-be outcome (`run_id` = the existing run for a reused idempotency\nkey, else empty)."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Idempotency key."
          },
          "input": {
            "description": "Workflow input (any JSON value; defaults to null)."
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Priority."
          },
          "queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Queue override."
          },
          "retention": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retention override for the terminal run (friendly duration in hours or smaller\nunits, e.g. `\"168h\"`; `7d` is rejected). Unset: workflow policy, queue policy, then\nthe server's `[runs] retention`."
          },
          "schedule_to_start_timeout": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schedule-to-start timeout override (friendly duration, e.g. `\"30s\"`; `\"0s\"` = none).\nUnset: the workflow policy, then the queue policy."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant."
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C traceparent."
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Explicit version (else the active one).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "StartRunResponse": {
        "type": "object",
        "description": "Start-run result.",
        "required": [
          "run_id",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "`false` when an existing run was returned."
          },
          "dry_run": {
            "type": "boolean",
            "description": "`true` for a dry run (omitted otherwise). A dry run returns the existing run's id\nfor a reused idempotency key, else an empty `run_id`."
          },
          "run_id": {
            "type": "string",
            "description": "Run id."
          }
        }
      },
      "StopRunBody": {
        "type": "object",
        "description": "Cancel / terminate body (the whole body is optional).",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Validate only; nothing is submitted."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason (<= 1024 bytes), recorded in history."
          }
        },
        "additionalProperties": false
      },
      "TerminateResponseDto": {
        "type": "object",
        "description": "Terminate result.",
        "required": [
          "status",
          "dry_run"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Echo of the request flag."
          },
          "status": {
            "$ref": "#/components/schemas/RunStatusDto",
            "description": "Status afterwards (`terminated`)."
          }
        }
      },
      "TriggerScheduleBody": {
        "type": "object",
        "description": "Manual trigger body (optional).",
        "properties": {
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Idempotency of the manual fire (1..=64 bytes): a repeat returns the same run."
          }
        },
        "additionalProperties": false
      },
      "TriggerScheduleResponseDto": {
        "type": "object",
        "description": "Manual trigger result.",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "description": "The started (or deduplicated) run."
          }
        }
      },
      "UpgradeStatus": {
        "type": "object",
        "description": "`GET /v1/cluster/upgrade`.",
        "required": [
          "finalized",
          "common_level_max",
          "auto_finalize",
          "members"
        ],
        "properties": {
          "auto_finalize": {
            "type": "boolean",
            "description": "`[cluster] auto_finalize`."
          },
          "common_level_max": {
            "type": "integer",
            "format": "int32",
            "description": "The highest level every member supports.",
            "minimum": 0
          },
          "finalized": {
            "type": "integer",
            "format": "int32",
            "description": "Finalized feature level.",
            "minimum": 0
          },
          "hold": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Operator hold.",
            "minimum": 0
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberLevel"
            },
            "description": "Per-member levels."
          }
        }
      },
      "UploadModuleResponse": {
        "type": "object",
        "description": "Upload result.",
        "required": [
          "module",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "`false` on idempotent re-upload."
          },
          "module": {
            "$ref": "#/components/schemas/ModuleDto",
            "description": "The stored module."
          }
        }
      },
      "VerifierDto": {
        "type": "object",
        "description": "Signature verifier. The secret is never returned: `secret_ref` names a sealed\nsecret.",
        "properties": {
          "algorithm": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: `sha256` (default) or `legacy_sha1`."
          },
          "encoding": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: `hex` or `base64`."
          },
          "header": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signature header."
          },
          "kind": {
            "$ref": "#/components/schemas/VerifierKindDto",
            "description": "Kind."
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signature prefix (e.g. `sha256=`)."
          },
          "secret_ref": {
            "type": "string",
            "description": "Sealed secret name (required unless kind = none)."
          },
          "template": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: signed template (`{body}` or `{ts}.{body}`)."
          },
          "timestamp_header": {
            "type": [
              "string",
              "null"
            ],
            "description": "Generic HMAC: timestamp header."
          },
          "tolerance_s": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Replay window, seconds (unset = the verifier default).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "VerifierKindDto": {
        "type": "string",
        "description": "Signature verifier kind.",
        "enum": [
          "none",
          "stripe",
          "github",
          "slack",
          "standard",
          "hmac"
        ]
      },
      "VersionOrSha": {
        "oneOf": [
          {
            "type": "object",
            "description": "A workflow version number.",
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "format": "int32",
                "description": "A workflow version number.",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "description": "A module sha256 (hex).",
            "required": [
              "sha"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "description": "A module sha256 (hex)."
              }
            }
          }
        ],
        "description": "The source of a migration: a workflow version or a module sha."
      },
      "WasmBytes": {
        "type": "string",
        "format": "binary",
        "description": "Raw Wasm component bytes (documentation-only schema of the upload body)."
      },
      "WebhookActionDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "Start a run (idempotency key = the delivery key, conflict policy return-existing).",
            "required": [
              "workflow",
              "kind"
            ],
            "properties": {
              "input": {
                "type": "string",
                "description": "`\"body\"` (the whole body) or a JSON pointer into it."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "start"
                ]
              },
              "version": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int32",
                "description": "Version (unset = active).",
                "minimum": 0
              },
              "workflow": {
                "type": "string",
                "description": "Workflow."
              }
            }
          },
          {
            "type": "object",
            "description": "Signal a run (request id = the delivery key).",
            "required": [
              "workflow",
              "run_by",
              "name",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "signal"
                ]
              },
              "name": {
                "type": "string",
                "description": "Signal name."
              },
              "run_by": {
                "$ref": "#/components/schemas/RunByDto",
                "description": "How the run is found."
              },
              "workflow": {
                "type": "string",
                "description": "Workflow of the target run."
              }
            }
          },
          {
            "type": "object",
            "description": "Complete an await token.",
            "required": [
              "token_pointer",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "complete_token"
                ]
              },
              "token_pointer": {
                "type": "string",
                "description": "JSON pointer to the token in the body."
              }
            }
          }
        ],
        "description": "What a verified delivery does."
      },
      "WebhookDto": {
        "type": "object",
        "description": "An inbound webhook (meta `Webhook`).",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/WebhookActionDto",
            "description": "Action."
          },
          "idempotency": {
            "type": [
              "string",
              "null"
            ],
            "description": "`header:<name>`, `json:<pointer>` or `none` (unset = the verifier's default)."
          },
          "name": {
            "type": "string",
            "description": "Webhook name (`[A-Za-z0-9_.-]{1,128}`), the `{name}` of `POST /hooks/{name}`."
          },
          "verifier": {
            "$ref": "#/components/schemas/VerifierDto",
            "description": "Verifier."
          },
          "version_tag": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Meta record version (CAS input on PUT).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "WebhookListResponse": {
        "type": "object",
        "description": "Webhook listing.",
        "required": [
          "webhooks"
        ],
        "properties": {
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDto"
            },
            "description": "Every webhook, by name."
          }
        }
      },
      "WorkerInfo": {
        "type": "object",
        "description": "A connected worker.",
        "required": [
          "worker_id",
          "labels",
          "slots",
          "free_slots",
          "leases",
          "connected_at_ms",
          "node_id",
          "draining"
        ],
        "properties": {
          "connected_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "When the session opened (Unix ms).",
            "minimum": 0
          },
          "draining": {
            "type": "boolean",
            "description": "Draining: no new work is assigned."
          },
          "free_slots": {
            "type": "integer",
            "format": "int32",
            "description": "Slots not holding a lease.",
            "minimum": 0
          },
          "labels": {
            "type": "object",
            "description": "Worker labels (matched by queue selectors).",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "leases": {
            "type": "integer",
            "format": "int32",
            "description": "Leases held.",
            "minimum": 0
          },
          "node_id": {
            "type": "integer",
            "format": "int64",
            "description": "Server node holding the session.",
            "minimum": 0
          },
          "slots": {
            "type": "integer",
            "format": "int32",
            "description": "Advertised slots.",
            "minimum": 0
          },
          "worker_id": {
            "type": "string",
            "description": "Worker id (from its certificate)."
          }
        }
      },
      "WorkerList": {
        "type": "object",
        "description": "`GET /v1/workers` response.",
        "required": [
          "workers"
        ],
        "properties": {
          "workers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerInfo"
            },
            "description": "Workers, sorted by id."
          }
        }
      },
      "WorkerTokenCreated": {
        "type": "object",
        "description": "A freshly created join token. `token` is shown here once and never again;\n`Debug` redacts it (and the join command that embeds it).",
        "required": [
          "token_id",
          "token",
          "join_command",
          "expires_at_ms"
        ],
        "properties": {
          "expires_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Expiry (Unix ms).",
            "minimum": 0
          },
          "join_command": {
            "type": "string",
            "description": "A ready-to-run `ostro worker --join .. --token .. --ca-hash ..` line."
          },
          "token": {
            "type": "string",
            "description": "`wkr_<id>.<secret>`; only in this response."
          },
          "token_id": {
            "type": "string",
            "description": "Token id (`wkr_<id>`)."
          }
        }
      },
      "WorkerTokenInfo": {
        "type": "object",
        "description": "A join token without its secret.",
        "required": [
          "token_id",
          "created_at_ms"
        ],
        "properties": {
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time (Unix ms).",
            "minimum": 0
          },
          "expires_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Expiry (Unix ms), when set.",
            "minimum": 0
          },
          "token_id": {
            "type": "string",
            "description": "Token id (`wkr_<id>`)."
          }
        }
      },
      "WorkerTokenList": {
        "type": "object",
        "description": "`GET /v1/workers/tokens` response.",
        "required": [
          "tokens"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerTokenInfo"
            },
            "description": "Tokens, sorted by id."
          }
        }
      },
      "WorkflowDto": {
        "type": "object",
        "description": "A workflow.",
        "required": [
          "name",
          "versions",
          "record_version"
        ],
        "properties": {
          "active_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Active version.",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "record_version": {
            "type": "integer",
            "format": "int64",
            "description": "Record version (CAS token for activation; also accepted via `If-Match`).",
            "minimum": 0
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowVersionDto"
            },
            "description": "Versions, ascending."
          }
        }
      },
      "WorkflowRefDto": {
        "type": "object",
        "description": "Workflow name + version.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Workflow name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Workflow version.",
            "minimum": 0
          }
        }
      },
      "WorkflowVersionDto": {
        "type": "object",
        "description": "One workflow version.",
        "required": [
          "version",
          "module_sha256"
        ],
        "properties": {
          "default_queue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default queue."
          },
          "module_sha256": {
            "type": "string",
            "description": "Implementing module."
          },
          "run_timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Default run timeout in ms.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          }
        }
      },
      "WorkflowVersionRef": {
        "type": "object",
        "description": "One workflow version named by a retirement.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Workflow name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version.",
            "minimum": 0
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "modules",
      "description": "Wasm module storage"
    },
    {
      "name": "workflows",
      "description": "Workflow versions and activation"
    },
    {
      "name": "runs",
      "description": "Starting and inspecting runs"
    },
    {
      "name": "tokens",
      "description": "Await-token completion"
    },
