            "description": "Run id."
          }
        }
      },
      "RunPauseMark": {
        "type": "object",
        "description": "The pause mark of a paused run, shown on `GET /v1/runs/{id}` (07-22, OPS-01).",
        "required": [
          "reason",
          "detail",
          "at_ms"
        ],
        "properties": {
          "at_ms": {
