# OCI image labels (key=value, one per line). scripts/build-image.sh adds at build time:
#   org.opencontainers.image.version   (workspace version from Cargo.toml)
#   org.opencontainers.image.revision  (git HEAD of the build tree)
#   org.opencontainers.image.created   (SOURCE_DATE_EPOCH, RFC 3339 UTC)
org.opencontainers.image.title=ostro
org.opencontainers.image.description=Ostro durable Wasm workflow engine (static musl binary, FROM scratch)
org.opencontainers.image.licenses=Apache-2.0
org.opencontainers.image.source=https://github.com/lspecian/ostro
