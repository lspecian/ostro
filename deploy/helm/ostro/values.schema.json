{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ostro Helm chart values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 40
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "server": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "enum": [
            1,
            3,
            5
          ]
        },
        "clusterId": {
          "type": "string",
          "pattern": "^([A-Za-z0-9._-]{1,128})?$"
        },
        "partitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ports": {
          "type": "object",
          "properties": {
            "client": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "cluster": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "replication": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "additionalProperties": false,
          "required": [
            "client",
            "cluster",
            "replication"
          ]
        },
        "logLevel": {
          "type": "string",
          "minLength": 1
        },
        "apiTls": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "self-signed",
                "files",
                "off"
              ]
            },
            "existingSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        "ui": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|K|M|G|T|P)?$"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "size"
          ]
        },
        "antiAffinity": {
          "type": "string",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "array"
        },
        "extraConfig": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "required": [
        "replicas",
        "ports"
      ]
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "slots": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "joinToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "caHash": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "cacheSize": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "token",
            "none"
          ]
        },
        "allowInsecureNone": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapToken": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "sealing": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "oldKeys": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "clusterCa": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "certKey": {
              "type": "string",
              "minLength": 1
            },
            "keyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "keda": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scaler": {
          "type": "string",
          "enum": [
            "prometheus",
            "metrics-api"
          ]
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "serverAddress": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "metricsApi": {
          "type": "object",
          "properties": {
            "tokenSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "unsafeSsl": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientFromNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "serverEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "workerEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "image",
    "server",
    "worker",
    "auth",
    "sealing",
    "tls",
    "keda",
    "networkPolicy"
  ]
}
