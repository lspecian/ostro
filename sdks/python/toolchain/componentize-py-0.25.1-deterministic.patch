@@ -0,0 +1,100 @@
+//! Deterministic pre-initialization (reproducible builds).
+//!
+//! Pre-init snapshots the guest's memory, so anything the interpreter reads
+//! from the host while initializing ends up in the output: random bytes (the
+//! str hash secret, `random` seeding), clock readings and the mtimes of the
+//! files it imports (cached by importlib).  Pin all of them so the same inputs
+//! produce the same component bytes.
+
+use std::{
+    fs::{self, File, FileTimes},
+    path::Path,
+    sync::atomic::{AtomicU64, Ordering},
+    time::{Duration, SystemTime},
+};
+
+use anyhow::Result;
+use wasmtime_wasi::{
+    Deterministic, WasiCtxBuilder,
+    clocks::{HostMonotonicClock, HostWallClock},
+};
+
+/// `SOURCE_DATE_EPOCH` (seconds) when set, else 0.
+fn epoch() -> u64 {
+    std::env::var("SOURCE_DATE_EPOCH")
+        .ok()
+        .and_then(|v| v.trim().parse().ok())
+        .unwrap_or(0)
+}
+
+fn bytes() -> Vec<u8> {
+    (0u32..256)
+        .map(|i| (i.wrapping_mul(167).wrapping_add(13) & 0xff) as u8)
+        .collect()
+}
+
+/// A wall clock starting at `SOURCE_DATE_EPOCH` that advances 1 µs per read.
+struct FixedWall {
+    base: Duration,
+    reads: AtomicU64,
+}
+
+impl HostWallClock for FixedWall {
+    fn resolution(&self) -> Duration {
+        Duration::from_micros(1)
+    }
+    fn now(&self) -> Duration {
+        self.base + Duration::from_micros(self.reads.fetch_add(1, Ordering::Relaxed))
+    }
+}
+
+/// A monotonic clock that advances 1 µs per read.
+struct FixedMonotonic {
+    reads: AtomicU64,
+}
+
+impl HostMonotonicClock for FixedMonotonic {
+    fn resolution(&self) -> u64 {
+        1_000
+    }
+    fn now(&self) -> u64 {
+        self.reads.fetch_add(1, Ordering::Relaxed) * 1_000
+    }
+}
+
+/// Fixed random sources and clocks for the pre-init WASI context.
+pub fn configure(wasi: &mut WasiCtxBuilder) {
+    wasi.secure_random(Deterministic::new(bytes()))
+        .insecure_random(Deterministic::new(bytes()))
+        .insecure_random_seed(0x6f73_7472_6f2d_7265_7072_6f2d_7365_6564)
+        .wall_clock(FixedWall {
+            base: Duration::from_secs(epoch()),
+            reads: AtomicU64::new(0),
+        })
+        .monotonic_clock(FixedMonotonic {
+            reads: AtomicU64::new(0),
+        });
+}
+
+/// Sets the access and modification times of `path` and everything below it to
+/// `SOURCE_DATE_EPOCH` (the status-change/birth time cannot be set from user space).
+pub fn pin_mtimes(path: &Path) -> Result<()> {
+    let t = SystemTime::UNIX_EPOCH + Duration::from_secs(epoch());
+    pin(path, t)
+}
+
+fn pin(path: &Path, t: SystemTime) -> Result<()> {
+    let meta = fs::symlink_metadata(path)?;
+    if meta.is_dir() {
+        let mut entries = fs::read_dir(path)?.collect::<Result<Vec<_>, _>>()?;
+        entries.sort_by_key(|e| e.file_name());
+        for entry in entries {
+            pin(&entry.path(), t)?;
+        }
+    } else if !meta.is_file() {
+        return Ok(());
+    }
+    // Directories last, after their children were touched.
+    File::open(path)?.set_times(FileTimes::new().set_accessed(t).set_modified(t))?;
+    Ok(())
+}
